@using Web.BlazorServer.ViewModels.Transaction.Commons
@using Web.BlazorServer.ViewModels.Transaction.SalesReturn

@inherits BaseComponent

<RadzenStack Gap="2rem">
    <AppDataGrid @ref="@ReturnItemsDataGrid"
                 Id="sales_return_item_selection_grid"
                 TItem="ItemVM"
                 GridSettingsLoaded="@GridSettingsLoaded"
                 DataGetter="@LoadDataAsync"
                 ActionName="ActionGetItems"
                 SelectedItems="@SelectedItems"
                 DataGridSelectionMode="DataGridSelectionMode.Multiple"
                 OnRowSelect="@OnRowSelect"
                 OnRowDeselect="@OnRowDeselect">
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                <SelectAllHeader Value="@GetSelectionHeaderState()" OnChange="@ToggleAllItems" ShowCheckbox="false" />
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
            </RadzenStack>
        </HeaderTemplate>
        <GridColumns>
            <RadzenDataGridColumn TItem="ItemVM"
                                  Width="45px"
                                  TextAlign="TextAlign.Center"
                                  Frozen
                                  FrozenPosition="FrozenColumnPosition.Left"
                                  Filterable="false" Sortable="false" Pickable="false">
                <HeaderTemplate>
                    <SelectAllHeader Value="@GetSelectionHeaderState()"
                                     OnChange="@ToggleAllItems"
                                     ShowButton="false"
                                     CheckboxName="sales_return_item_selection_grid_select_all" />
                </HeaderTemplate>
                <Template Context="data">
                    <RadzenCheckBox Value="@(SelectedItems.Any(si => si.ItemCode == data.ItemCode))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemVM"
                                  Title="Item Code"
                                  Property="@nameof(ItemVM.ItemCode)"
                                  Type="@typeof(string)" />
            <RadzenDataGridColumn TItem="ItemVM"
                                  Title="Item Name"
                                  Property="@nameof(ItemVM.ItemName)"
                                  Type="@typeof(string)" />
            <RadzenDataGridColumn TItem="ItemVM"
                                  Title="UoM"
                                  Property="@nameof(ItemVM.UoMName)"
                                  Type="@typeof(string)" />
        </GridColumns>
    </AppDataGrid>
</RadzenStack>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="ItemVM"
                                    @bind-Grid=@ReturnItemsDataGrid.DataGrid
                                    @bind-GridSettings=@ReturnItemsDataGridSettings />,
        options: GridSettingsService.GetDialogOptions());

        await ReturnItemsDataGrid.DataGrid.Reload();
    }
}
