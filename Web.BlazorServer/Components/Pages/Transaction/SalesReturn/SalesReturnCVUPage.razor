@using Web.BlazorServer.Components.Pages.Transaction.SalesReturn.Components
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.Extensions
@using Web.BlazorServer.ViewModels.Others
@using Web.BlazorServer.ViewModels.Transaction.SalesReturn

@inherits BaseForm<SalesReturnVM>
@page "/transactions/sales/sales-return/create"
@page "/transactions/sales/sales-return/view"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OSRN")]

<PageTitle>@(Creating ? "New Sales Return Document" : string.Empty)@(Viewing ? $"Sales Return {FormData.SapReference.DocNum}" : string.Empty)</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OSRN" />
</RadzenStack>

<AppContent>

    <AppFormSkeleton TItem="SalesReturnVM" Loading="@IsLoadingData" />

    <RadzenStack Visible="@(!IsLoadingData)" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="32px" class="rz-mb-2">
        <AppContentBadge Visible="@Viewing" Title="Doc" Content="@FormData.SapReference.DocNum.ToString()" />
        <AppContentBadge Title="Doc Date" Content="@FormData.DocDate.ToString("MM-dd-yy")" ChildBadgeStyle="BadgeStyle.Secondary" ChildShade="Shade.Default" />
        <AppContentBadge Title="Doc Due Date" Content="@FormData.DocDueDate.ToString("MM-dd-yy")" ChildBadgeStyle="BadgeStyle.Secondary" ChildShade="Shade.Default" />
    </RadzenStack>

    <RadzenTemplateForm Visible="@(!IsLoadingData)" @ref="@TemplateForm" TItem="SalesReturnVM" @bind-Data="@FormData" EditContext="@EditContext" Submit="@HandleSubmit">
        <RadzenStack Gap="1rem">

            <RadzenFieldset AllowCollapse Text="Details">
                <ChildContent>
                    <RadzenStack Gap="0.5rem">

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Customer" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Visible="@Viewing" Value="@FormData.BusinessPartner.CardName" Name="sr_card_name" Disabled="@IsBusy" class="rz-w-100" />
                                        <RadzenDropDown Visible="@Creating"
                                                        @bind-Value="@FormData.BusinessPartner"
                                                        Change="(args) => OnFieldChanged(nameof(FormData.BusinessPartner))"
                                                        Data="@Customers"
                                                        Count="@CustomersCount"
                                                        LoadData="@LoadCustomers"
                                                        AllowVirtualization
                                                        Name="sr_bp"
                                                        AllowFiltering
                                                        TextProperty="@nameof(BusinessPartnerVM.CardName)"
                                                        Placeholder="No Customer Selected"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                    <End>
                                        <RadzenButton Visible="@(Creating && !FormData.ValidateBusinessPartner())" Size="ButtonSize.ExtraSmall" Text="Copy From Delivery" Click="@CopyFromDelivery" />
                                    </End>
                                    <Helper>
                                        <RadzenCustomValidator Visible="@Creating" Component="sr_bp" Popup Validator="@FormData.ValidateBusinessPartner" Text="Customer is required" />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Return Type" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Visible="@Viewing" Value="@FormData.ReturnType" Name="sr_return_type" Placeholder="No Return Type" Disabled="@IsBusy" class="rz-w-100" />
                                        <RadzenDropDown Visible="@Creating"
                                                        @bind-Value="@FormData.ReturnType"
                                                        Data="@ReturnTypes"
                                                        Name="sr_ret_typ"
                                                        AllowFiltering
                                                        TextProperty="@nameof(ReturnTypeVM.Value)"
                                                        ValueProperty="@nameof(ReturnTypeVM.Code)"
                                                        Placeholder="No Return Type"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="School Year" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox Visible="@Viewing" ReadOnly Value="@FormData.SchoolYear" Name="sr_school_year" Placeholder="No School Year" Disabled="@IsBusy" class="rz-w-100" />
                                        <RadzenDropDown Visible="@Creating"
                                                        @bind-Value="@FormData.SchoolYear"
                                                        Data="@SchoolYears"
                                                        Count="@SchoolYearsCount"
                                                        LoadData="@LoadSchoolYears"
                                                        ValueProperty="@nameof(SchoolYearVM.Code)"
                                                        TextProperty="@nameof(SchoolYearVM.Name)"
                                                        AllowVirtualization
                                                        AllowClear
                                                        Name="sr_sy"
                                                        AllowFiltering
                                                        Placeholder="No School Year"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Source Warehouse" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Visible="@Viewing" Value="@FormData.Warehouse?.WhsName" Name="sr_whs_name" Placeholder="No Warehouse Selected" Disabled="@IsBusy" class="rz-w-100" />
                                        <RadzenDropDown Visible="@Creating"
                                                        @bind-Value="@FormData.Warehouse"
                                                        Change="(args) => OnFieldChanged(nameof(FormData.Warehouse))"
                                                        Data="@Warehouses"
                                                        Count="@WarehousesCount"
                                                        LoadData="@LoadWarehouses"
                                                        AllowVirtualization
                                                        Name="sr_whs"
                                                        AllowFiltering
                                                        TextProperty="@nameof(WarehouseVM.WhsName)"
                                                        Placeholder="No Warehouse Selected"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenCustomValidator Visible="@(Creating && FormData.Standalone)" Component="sr_whs" Popup Validator="@FormData.ValidateWarehouse" Text="Source Warehouse is required" />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="DR No." class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.DRNo" Placeholder="DR-015" Name="sr_dr_no" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="SI No." class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.SINo" Placeholder="SI-06" Name="sr_si_no" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                    </RadzenStack>
                </ChildContent>
            </RadzenFieldset>

            <RadzenFieldset AllowCollapse Text="Items">
                <ChildContent>
                    <RadzenRow>
                        <RadzenColumn>
                            <AppTable @ref="@SalesReturnTable"
                                      Id="sales_return_cvu_items"
                                      TItem="SalesReturnLineVM"
                                      @bind-GridSettingsLoaded="@GridSettingsLoaded"
                                      Data="@FormData.DocumentLines">
                                <HeaderTemplate>
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                                        <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                                        <RadzenButton Visible="@(Creating && FormData.Standalone)" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@AddItems" Disabled="@(string.IsNullOrEmpty(FormData.Warehouse?.WhsCode))" />
                                    </RadzenStack>
                                </HeaderTemplate>
                                <Columns>
                                    <RadzenDataGridColumn TItem="SalesReturnLineVM"
                                                          Width="40px" TextAlign="TextAlign.Center">
                                        <Template Context="data">
                                            @(FormData.DocumentLines.IndexOf(data) + 1)
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="SalesReturnLineVM"
                                                          Property="@nameof(SalesReturnLineVM.ItemCode)"
                                                          Type="@typeof(string)"
                                                          Title="Item Code" />
                                    <RadzenDataGridColumn TItem="SalesReturnLineVM"
                                                          Property="@nameof(SalesReturnLineVM.ItemName)"
                                                          Type="@typeof(string)"
                                                          Title="Item Name" />
                                    <RadzenDataGridColumn TItem="SalesReturnLineVM"
                                                          Property="@nameof(SalesReturnLineVM.Warehouse.WhsName)"
                                                          Type="@typeof(string)"
                                                          Title="Warehouse" Width="150px">
                                        <Template Context="data">
                                            @data.Warehouse.WhsName
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="SalesReturnLineVM"
                                                          Property="@nameof(SalesReturnLineVM.UoMName)"
                                                          Type="@typeof(string)"
                                                          Title="UoM" Width="125px" />
                                    <RadzenDataGridColumn Visible="@(Creating && !FormData.Standalone)" TItem="SalesReturnLineVM"
                                                          Property="@nameof(SalesReturnLineVM.OpenQuantity)"
                                                          Type="@typeof(decimal)"
                                                          Title="Open Qty" Width="150px">
                                        <Template Context="data">
                                            <RadzenNumeric Format="N0" @bind-Value="@data.OpenQuantity" Min="0" ReadOnly ShowUpDown="false" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="SalesReturnLineVM"
                                                          Property="@nameof(SalesReturnLineVM.Quantity)"
                                                          Type="@typeof(decimal)"
                                                          Title="Quantity" Width="150px">
                                        <Template Context="data">
                                            <RadzenNumeric Format="N0" @bind-Value="@data.Quantity" Min="0" Max="@(FormData.Standalone ? null : data.OpenQuantity)" ReadOnly="@(Viewing || (!FormData.Standalone && data.OpenQuantity <= 0))" ShowUpDown="@Creating" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="SalesReturnLineVM"
                                                          Type="@typeof(bool)"
                                                          Frozen
                                                          FrozenPosition="FrozenColumnPosition.Right"
                                                          Width="45px"
                                                          MaxWidth="45px"
                                                          Pickable="false" Sortable="false" Filterable="false"
                                                          Visible="@Creating">
                                        <Template Context="data">
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceEvenly">
                                                <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger" Click="() => RemoveLine(data)" />
                                            </RadzenStack>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </AppTable>
                        </RadzenColumn>
                    </RadzenRow>
                </ChildContent>
            </RadzenFieldset>

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Remarks" class="rz-w-100" AllowFloatingLabel="false">
                        <ChildContent>
                            <RadzenTextArea ReadOnly="@Viewing" @bind-Value="@FormData.DocRemarks" Name="sr_remarks" Rows="3" Disabled="@IsBusy" class="rz-w-100" Placeholder="This Sales Return is for ..." />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4" OffsetMD="4">
                    <RadzenStack Gap="0.5rem">
                        <RadzenFormField Text="Prepared By" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly Value="@FormData.PreparedBy" Name="sr_prep_by" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="Checked By" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.CheckedBy" Name="sr_chkd_by" Placeholder="WMS User A" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="Noted By" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.NotedBy" Name="sr_noted_by" Placeholder="WMS User B" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="Approved By" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.ApprovedBy" Name="sr_app_by" Placeholder="WMS User C" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn>
                    <RadzenStack class="rz-mt-8" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenButton IsBusy="@IsBusy" Text="Back" Disabled="@(IsBusy && Creating)" ButtonStyle="ButtonStyle.Base" Click="@Back" />
                        <RadzenStack Visible="@(Can.Create("OSRN") && Creating)" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="16px">
                            <RadzenButton IsBusy="@IsBusy" Visible="@Creating" ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit">
                                Save
                            </RadzenButton>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

        </RadzenStack>
    </RadzenTemplateForm>

</AppContent>

@code {
    async Task AddItems()
    {
        await DialogService.OpenAsync(
            "Item Selection",
            ds => @<SalesReturnItemSelection @bind-Return="@FormData" />,
            options: GridSettingsService.GetDialogOptions().MaximizedMode());

        await SalesReturnTable.DataGrid.Reload();
    }

    async Task CopyFromDelivery()
    {
        bool? result = await DialogService.OpenAsync(
            "Delivery Selection",
            ds => @<SalesReturnDeliverySelection @bind-Document="@FormData" />,
            options: GridSettingsService.GetDialogOptions().MaximizedMode());

        if (result is not null && result is true)
            FormData.Standalone = false;

        await SalesReturnTable.DataGrid.Reload();
    }

    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="SalesReturnLineVM"
                                    @bind-Grid=@SalesReturnTable.DataGrid
                                    @bind-GridSettings=@SalesReturnTableSettings />,
            options: GridSettingsService.GetDialogOptions());

        await SalesReturnTable.DataGrid.Reload();
    }
}
