@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.ViewModels.Others
@using Web.BlazorServer.ViewModels.Transaction.SalesReturn

@inherits BaseForm<SalesReturnRequestVM>
@page "/transactions/sales/sales-return/request/create"
@page "/transactions/sales/sales-return/request/view"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "ORDN")]

<PageTitle>@(Creating ? "New Sales Return Document" : string.Empty)@(Viewing ? $"Sales Return Request {FormData.SapReference.DocNum}" : string.Empty)</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="ORDN" />
</RadzenStack>

<AppContent>

    <AppFormSkeleton TItem="SalesReturnRequestVM" Loading="@IsLoadingData" />

    <RadzenStack Visible="@(!IsLoadingData)" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="32px" class="rz-mb-2">
        <AppContentBadge Title="Doc Ref No." Content="@FormData.SapReference.DocNum.ToString()" />
        <AppContentBadge Title="Doc Date" Content="@FormData.DocDate.ToString("MM-dd-yy")" ChildBadgeStyle="BadgeStyle.Secondary" ChildShade="Shade.Default" />
        <AppContentBadge Title="Doc Due Date" Content="@FormData.DocDueDate.ToString("MM-dd-yy")" ChildBadgeStyle="BadgeStyle.Secondary" ChildShade="Shade.Default" />
    </RadzenStack>

    <RadzenTemplateForm Visible="@(!IsLoadingData)" @ref="@TemplateForm" TItem="SalesReturnRequestVM" @bind-Data="@FormData" EditContext="@EditContext" Submit="@HandleSubmit">
        <RadzenStack Gap="1rem">

            <RadzenFieldset AllowCollapse Text="Details">
                <ChildContent>
                    <RadzenStack Gap="0.5rem">

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Customer" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Value="@FormData.BusinessPartner.CardName" Name="srr_card_name" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Return Type" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Visible="@Viewing" Value="@FormData.ReturnType" Name="srr_return_type" Placeholder="No Return Type" Disabled="@IsBusy" class="rz-w-100" />
                                        <RadzenDropDown Visible="@Creating"
                                                        @bind-Value="@FormData.ReturnType"
                                                        Data="@ReturnTypes"
                                                        Name="srr_ret_typ"
                                                        AllowFiltering
                                                        TextProperty="@nameof(ReturnTypeVM.Value)"
                                                        ValueProperty="@nameof(ReturnTypeVM.Code)"
                                                        Placeholder="No Return Type"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="School Year" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox Visible="@Viewing" ReadOnly Value="@FormData.SchoolYear" Name="srr_school_year" Placeholder="No School Year" Disabled="@IsBusy" class="rz-w-100" />
                                        <RadzenDropDown Visible="@Creating"
                                                        @bind-Value="@FormData.SchoolYear"
                                                        Data="@SchoolYears"
                                                        Count="@SchoolYearsCount"
                                                        LoadData="@LoadSchoolYears"
                                                        ValueProperty="@nameof(SchoolYearVM.Code)"
                                                        TextProperty="@nameof(SchoolYearVM.Name)"
                                                        AllowVirtualization
                                                        AllowClear
                                                        Name="srr_sy"
                                                        AllowFiltering
                                                        Placeholder="No School Year"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Warehouse" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Value="@(string.Join(", ", FormData.DocumentLines.Select(x => x.Warehouse.WhsName).ToHashSet()))" Name="srr_whs_name" Placeholder="No Warehouse" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="DR No." class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.DRNo" Placeholder="DR-015" Name="srr_dr_no" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="SI No." class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.SINo" Placeholder="SI-06" Name="srr_si_no" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                    </RadzenStack>
                </ChildContent>
            </RadzenFieldset>

            <RadzenFieldset AllowCollapse Text="Items">
                <ChildContent>
                    <RadzenRow>
                        <RadzenColumn>
                            <AppTable @ref="@SalesReturnRequestTable"
                                      Id="sales_return_request_cvu_items"
                                      TItem="SalesReturnRequestLineVM"
                                      @bind-GridSettingsLoaded="@GridSettingsLoaded"
                                      Data="@FormData.DocumentLines">
                                <HeaderTemplate>
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                                        <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                                    </RadzenStack>
                                </HeaderTemplate>
                                <Columns>
                                    <RadzenDataGridColumn TItem="SalesReturnRequestLineVM"
                                                          Width="40px" TextAlign="TextAlign.Center">
                                        <Template Context="data">
                                            @(FormData.DocumentLines.IndexOf(data) + 1)
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="SalesReturnRequestLineVM"
                                                          Property="@nameof(SalesReturnRequestLineVM.ItemCode)"
                                                          Type="@typeof(string)"
                                                          Title="Item Code" />
                                    <RadzenDataGridColumn TItem="SalesReturnRequestLineVM"
                                                          Property="@nameof(SalesReturnRequestLineVM.ItemName)"
                                                          Type="@typeof(string)"
                                                          Title="Item Name" />
                                    <RadzenDataGridColumn TItem="SalesReturnRequestLineVM"
                                                          Property="@nameof(SalesReturnRequestLineVM.Warehouse.WhsName)"
                                                          Type="@typeof(string)"
                                                          Title="Warehouse" Width="150px">
                                        <Template Context="data">
                                            @data.Warehouse.WhsName
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="SalesReturnRequestLineVM"
                                                          Property="@nameof(SalesReturnRequestLineVM.UoMName)"
                                                          Type="@typeof(string)"
                                                          Title="UoM" Width="125px" />
                                    <RadzenDataGridColumn TItem="SalesReturnRequestLineVM"
                                                          Property="@nameof(SalesReturnRequestLineVM.TargetQuantity)"
                                                          Type="@typeof(decimal)"
                                                          Title="Target Qty" Width="150px">
                                        <Template Context="data">
                                            <RadzenNumeric Format="N0" @bind-Value="@data.TargetQuantity" Min="0" ReadOnly ShowUpDown="false" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="SalesReturnRequestLineVM"
                                                          Property="@nameof(SalesReturnRequestLineVM.OpenQuantity)"
                                                          Type="@typeof(decimal)"
                                                          Title="Open Qty" Width="150px">
                                        <Template Context="data">
                                            <RadzenNumeric Format="N0" @bind-Value="@data.OpenQuantity" Min="0" ReadOnly ShowUpDown="false" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="SalesReturnRequestLineVM"
                                                          Property="@nameof(SalesReturnRequestLineVM.Quantity)"
                                                          Type="@typeof(decimal)"
                                                          Title="Quantity" Width="150px">
                                        <Template Context="data">
                                            <RadzenNumeric Format="N0" @bind-Value="@data.Quantity" Min="0" Max="@data.OpenQuantity" ReadOnly="@(Viewing || data.OpenQuantity <= 0)" ShowUpDown="@Creating" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </AppTable>
                        </RadzenColumn>
                    </RadzenRow>
                </ChildContent>
            </RadzenFieldset>

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Remarks" class="rz-w-100" AllowFloatingLabel="false">
                        <ChildContent>
                            <RadzenTextArea ReadOnly="@Viewing" @bind-Value="@FormData.DocRemarks" Name="srr_remarks" Rows="3" Disabled="@IsBusy" class="rz-w-100" Placeholder="This Sales Return is for ..." />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4" OffsetMD="4">
                    <RadzenStack Gap="0.5rem">
                        <RadzenFormField Text="Prepared By" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly Value="@FormData.PreparedBy" Name="srr_prep_by" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="Checked By" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.CheckedBy" Name="srr_chkd_by" Placeholder="WMS User A" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="Noted By" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.NotedBy" Name="srr_noted_by" Placeholder="WMS User B" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="Approved By" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.ApprovedBy" Name="srr_app_by" Placeholder="WMS User C" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn>
                    <RadzenStack class="rz-mt-8" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenButton IsBusy="@IsBusy" Text="Back" Disabled="@(IsBusy && Creating)" ButtonStyle="ButtonStyle.Base" Click="@Back" />
                        <RadzenButton IsBusy="@IsBusy" Text="Create Sales Return" Visible="@(Can.Create("ORDN") && Viewing)" ButtonStyle="ButtonStyle.Base" Click="@InitializeEditing" />
                        <RadzenStack Visible="@(Can.Create("ORDN") && Creating)" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="16px">
                            <RadzenButton IsBusy="@IsBusy" ButtonStyle="ButtonStyle.Base" Click="@CancelEditing">
                                Cancel
                            </RadzenButton>
                            <RadzenButton IsBusy="@IsBusy" Visible="@Creating" ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit">
                                Save
                            </RadzenButton>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

        </RadzenStack>
    </RadzenTemplateForm>

</AppContent>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="SalesReturnRequestLineVM"
                                    @bind-Grid=@SalesReturnRequestTable.DataGrid
                                    @bind-GridSettings=@SalesReturnRequestTableSettings />,
        options: GridSettingsService.GetDialogOptions());

        await SalesReturnRequestTable.DataGrid.Reload();
    }
}
