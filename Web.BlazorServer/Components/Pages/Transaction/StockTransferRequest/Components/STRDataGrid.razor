@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Administration.User
@using Web.BlazorServer.ViewModels.Transaction.StockTransferRequest

@inherits BaseComponent

<AppDataGrid @ref="@DataGrid" Id="@TableId" TItem="StockTransferRequestDataGridVM" DataGetter="@LoadDataAsync" GridSettings="@DataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" ActionName="@ActionGetStockTransferRequests">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="8px">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="8px">
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                <RadzenButton Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="AddButtonPressed" Visible="@OnAddClicked.HasDelegate" />
                <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="DataGrid.ReloadDataAsync" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        <RadzenDataGridColumn TItem="StockTransferRequestDataGridVM"
                              Property="@nameof(StockTransferRequestDataGridVM.ReferenceNumber)"
                              Title="Reference Number" />
        <RadzenDataGridColumn TItem="StockTransferRequestDataGridVM"
                              Property="@nameof(StockTransferRequestDataGridVM.Date)"
                              Type="@typeof(DateTime)"
                              FormatString="{0:MMMM dd, yyyy}"
                              Title="Date" />
        <RadzenDataGridColumn TItem="StockTransferRequestDataGridVM"
                              FilterProperty="StatusName"
                              Property="@nameof(StockTransferRequestDataGridVM.StatusDisplayString)"
                              Type="@typeof(string)"
                              Title="Status" >

            <FilterTemplate>
                <div class="rz-grid-filter">
                    <RadzenStack Gap="0.5em">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-grid-filter-label">Filter</RadzenText>
                        <RadzenFormField>
                            <QuickVirtualizedDropdown @bind-Value="StatusFilter" TItem="TransferOrderStatusVM" DataGetter="TranferOrderStatusProvider" TextProperty="@nameof(TransferOrderStatusVM.Name)" />
                        </RadzenFormField>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                            <RadzenButton Click="@(() => ApplyStatusFilter(context))">Apply</RadzenButton>
                        </RadzenStack>
                    </RadzenStack>
                </div>
            </FilterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="StockTransferRequestDataGridVM"
                              Property="@nameof(StockTransferRequestDataGridVM.SourceLocation)"
                              Type="@typeof(string)"
                              Title="From Location" />
        <RadzenDataGridColumn TItem="StockTransferRequestDataGridVM"
                              Property="@nameof(StockTransferRequestDataGridVM.DestinationLocation)"
                              Type="@typeof(string)"
                              Title="To Location" />
        <RadzenDataGridColumn TItem="StockTransferRequestDataGridVM"
                              Property="@nameof(StockTransferRequestDataGridVM.Subsidiary)"
                              Type="@typeof(string)"
                              Title="From Subsidiary" />
        <RadzenDataGridColumn TItem="StockTransferRequestDataGridVM"
                              Property="@nameof(StockTransferRequestDataGridVM.ToSubsidiary)"
                              Type="@typeof(string)"
                              Title="To Subsidiary" />
        <RadzenDataGridColumn TItem="StockTransferRequestDataGridVM"
                              Property="@nameof(StockTransferRequestDataGridVM.PreparedBy)"
                              Type="@typeof(string)"
                              Title="Prepared By" />
        <RadzenDataGridColumn TItem="StockTransferRequestDataGridVM"
                              Property="@nameof(StockTransferRequestDataGridVM.Remarks)"
                              Type="@typeof(string)"
                              Title="Remarks" />
        <RadzenDataGridColumn TItem="StockTransferRequestDataGridVM"
                              Frozen
                              FrozenPosition="FrozenColumnPosition.Right"
                              Width="35px">
            <Template>
                <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Click="() => ViewSTR(context)" />
            </Template>
        </RadzenDataGridColumn>
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="StockTransferRequestDataGridVM"
                                    @bind-Grid=@DataGrid.DataGrid
                                    @bind-GridSettings=@DataGridSettings />,
        options: GridSettingsService.GetDialogOptions());

        await DataGrid.DataGrid.Reload();
    }
}