@using Mapster
@using Web.BlazorServer.Components.Pages.Transaction.Receiving.Components
@using Web.BlazorServer.Components.Pages.Transaction.StockTransferRequest.Components
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.Defaults
@using Web.BlazorServer.Handlers.Repositories.Transaction.StockTransferRequest
@using Web.BlazorServer.Services.Repositories
@using Web.BlazorServer.ViewModels.Administration.User
@using Web.BlazorServer.ViewModels.Transaction.Receiving
@using Web.BlazorServer.ViewModels.Transaction.StockTransferRequest

@inherits BaseForm<StockTransferRequestInfoVM>
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OSTR")]
@attribute [Route(STRRoutes.Update)]


<PageTitle>Updating Stock Transfer Request @Ref</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OSTR" AdditionalRoutes="AdditionalRoutes" />
</RadzenStack>
<AppContent>
<AppFormSkeleton TItem="StockTransferRequestInfoVM" Loading="@IsLoadingData" />
@if (!IsLoadingData)
{
    <STRForm OnSubmit="@Update" Model="@FormData" EditContext="@EditContext" ReturnURI="@(STRRoutes.View + $"?ref={Ref}")" IsBusy="@IsUploadingData"/>
}
</AppContent>
    @code {
    [Inject] IStockTransferRequestHandler handler { get; set; } = default!;
    [Inject] IBusyDialogService BusyDialogService { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? Ref { get; set; }

    bool IsLoadingData => AppBusyService.IsBusy(ActionGetStockTransferRequest);
    bool IsUploadingData => AppBusyService.IsBusy(ActionUpdateStockTransferRequest);

    readonly string ActionGetStockTransferRequest = "Get Stock Transfer Request";
    readonly string ActionUpdateStockTransferRequest = "Update Stock Transfer Request";

    
    List<ViewModels.System.NavigationRouteVM> AdditionalRoutes { get; set; } = [new() {
        Name = "Stock Transfer Document",
        Position = 0,
        Icon = "assignment",
    }];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (string.IsNullOrEmpty(Ref)) NavError("Please select a stock transfer request from the list");
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        AppBusyService.BusyChanged += OnBusyChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            AppBusyService.SetBusy(ActionGetStockTransferRequest, true);
            await InvokeAsync(StateHasChanged);
            await LoadDataAsync();
        }
    }

    async Task LoadDataAsync()
    {
        var action = await AppActionFactory.RunAsync(async () =>
        {
            if (string.IsNullOrEmpty(Ref)) throw new Exception("Please select a stock transfer request from the list");

            var response = await handler.GetStockTransferRequest(Ref);

            if (response is null) throw new Exception($"Stock transfer request \"{Ref}\" could not be found");
            if (!response.IsEditable)
                throw new Exception($"Stock transfer request \"{Ref}\" is not editable and cannot be updated");

            return response;
        }, AppActionOptionPresets.Loading(ActionGetStockTransferRequest));

        action.OnSuccess(async (res) =>
        {
            res.Adapt(FormData);
            AdditionalRoutes[0].Name = FormData.Category.Name;
            await InvokeAsync(StateHasChanged);
        });

        action.OnFailure(ex =>
        {
            return Task.Delay(100).ContinueWith(_ =>
            {
                NavManager.NavigateTo(STRRoutes.Root);
            });
        });
    }

    async Task<bool> Update(StockTransferRequestInfoVM model)
    {
        if (model.Lines.Any(x => x.QuantityAlloted > x.QuantityAvailable))
        {
            ToastService.Error("Some alloted quantities exceed the available quantity");
            return false;
        }

        var action = await AppActionFactory.RunAsync(async () =>
        {
            return await handler.UpdateStockTransferRequest(model);
        }, AppActionOptionPresets.Confirmed(ActionUpdateStockTransferRequest));

        action.OnSuccess(res =>
        {
            NavManager.NavigateTo(STRRoutes.Root);
            return Task.CompletedTask;
        });

        await InvokeAsync(StateHasChanged);
        return true;
    }

    void OnBusyChanged(string key, bool isBusy)
    {
        if (!key.Equals(ActionUpdateStockTransferRequest))
            return;

        if (isBusy)
            BusyDialogService.Show(title: ActionUpdateStockTransferRequest);
        else
            BusyDialogService.Hide();

        _ = InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        AppBusyService.BusyChanged -= OnBusyChanged;
        base.Dispose();
    }

    void NavError(string message)
    {
        ToastService.Error(message);
        NavManager.NavigateTo(STRRoutes.Root);
    }


    protected override Task InitializeEditing() => throw new NotImplementedException();
    protected override Task CancelEditing() => throw new NotImplementedException();
    protected override Task HandleSubmit() => throw new NotImplementedException();
}
