@using Mapster
@using Web.BlazorServer.Components.Pages.Transaction.Receiving.Components
@using Web.BlazorServer.Components.Pages.Transaction.StockTransferRequest.Components
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.Defaults
@using Web.BlazorServer.Handlers.Repositories.Transaction.StockTransferRequest
@using Web.BlazorServer.ViewModels.Administration.User
@using Web.BlazorServer.ViewModels.Transaction.Receiving
@using Web.BlazorServer.ViewModels.Transaction.StockTransferRequest

@inherits BaseForm<StockTransferRequestInfoVM>
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "ORCV")]
@attribute [Route(STRRoutes.Create)]


<PageTitle>Creating Stock Transfer Request</PageTitle>

<AppContent>
<STRForm OnSubmit="@Create" Model="@FormData" EditContext="@EditContext" ReturnURI="@STRRoutes.Root" />
</AppContent>

@code {
    [Inject] IStockTransferRequestHandler handler { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? Ref { get; set; }

    [SupplyParameterFromQuery]
    public string? Type { get; set; }

    readonly string ActionGetStockTransferRequest = "Get Stock Transfer Request";
    readonly string ActionCreateStockTransferRequest = "Create Stock Transfer Request";

    bool IsLoadingData => AppBusyService.IsBusy(ActionGetStockTransferRequest);


    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Type is not null)
        {
            FormData.Type = Type.ToLowerInvariant() switch
            {
                "intercompanytransferorder" => StockTransferRequestInfoVM.Types.IntercompanyTransferOrder,
                "returns" => StockTransferRequestInfoVM.Types.Returns,
                _ => StockTransferRequestInfoVM.Types.TransferOrder
            };
        }
        FormData.Date = DateTime.Now;
    }

    async Task<bool> Create(StockTransferRequestInfoVM model)
    {
        var action = await AppActionFactory.RunAsync(async () =>
        {
            return await handler.CreateStockTransferRequest(model);
        }, AppActionOptionPresets.Confirmed(ActionCreateStockTransferRequest));

        action.OnSuccess(res =>
        {
            NavManager.NavigateTo(STRRoutes.Root);
            return Task.CompletedTask;
        });

        action.OnFailure(ex =>
        {
            ToastService.Error(ex.Message);
            return Task.CompletedTask;
        });

        return true;
    }

    protected override Task InitializeEditing() => throw new NotImplementedException();
    protected override Task CancelEditing() => throw new NotImplementedException();
    protected override Task HandleSubmit() => throw new NotImplementedException();
}