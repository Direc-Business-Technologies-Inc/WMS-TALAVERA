@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.Components.Pages.Transaction.Others.BarcodeScanning
@using Web.BlazorServer.ViewModels.Transaction.Packing.Returns
@inherits BaseComponent

<RadzenTemplateForm TItem="ReturnsItemReceiptPackingVM" EditContext="@EditContext" Submit="@Submit">
    <RadzenStack Gap="0.5em">
        <RadzenFieldset Text="Details" AllowCollapse>
            <RadzenRow Gap="0.5em">
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Created From" class="rz-w-100">
                        <RadzenTextBox Value="@Data.CreatedFrom" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Date" class="rz-w-100">
                        <RadzenDatePicker @bind-Value="@Data.Date" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="From Subsidiary" class="rz-w-100">
                        <RadzenTextBox Value="@Data.Subsidiary" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="To Subsidiary" class="rz-w-100">
                        <RadzenTextBox Value="@Data.ToSubsidiary" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="From Warehouse" class="rz-w-100">
                        <RadzenTextBox Value="@Data.Location" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="To Warehouse" class="rz-w-100">
                        <RadzenTextBox Value="@Data.TransferLocation" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Department" class="rz-w-100">
                        <RadzenTextBox Value="@Data.Department" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Transfer Category" class="rz-w-100">
                        <RadzenTextBox ReadOnly Value="@Data.TransferCategory" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenFieldset AllowCollapse Text="Lines">
            <AppTableWithSettings Data="@FulfillableLines" Id="packing_returns_item_receipt_lines">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5em">
                        <RadzenButton Icon="barcode" ButtonStyle="ButtonStyle.Primary" Click="(() => OpenBarcodeDialog(false))" Size="ButtonSize.Small" Text="Scan Barcodes" />
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="ReturnsItemReceiptLinePackingVM" Width="30px">
                        <Template Context="data">
                            <RadzenCheckBox @bind-Value="data.IsReceived" Disabled="data.IsComplete" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ReturnsItemReceiptLinePackingVM" Property="@nameof(ReturnsItemReceiptLinePackingVM.ItemCode)" Title="Item Code" />
                    <RadzenDataGridColumn TItem="ReturnsItemReceiptLinePackingVM" Property="@nameof(ReturnsItemReceiptLinePackingVM.ItemDescription)" Title="Item Description" />
                    <RadzenDataGridColumn TItem="ReturnsItemReceiptLinePackingVM" Property="@nameof(ReturnsItemReceiptLinePackingVM.UoM)" Title="UoM" />
                    <RadzenDataGridColumn TItem="ReturnsItemReceiptLinePackingVM" Property="@nameof(ReturnsItemReceiptLinePackingVM.Location)" Title="Warehouse" />
                    <RadzenDataGridColumn TItem="ReturnsItemReceiptLinePackingVM" Property="@nameof(ReturnsItemReceiptLinePackingVM.QuantityPlanned)" Title="Planned Quantity" />
                    <RadzenDataGridColumn TItem="ReturnsItemReceiptLinePackingVM" Property="@nameof(ReturnsItemReceiptLinePackingVM.QuantityReceived)" Title="Received Quantity" />
                    <RadzenDataGridColumn TItem="ReturnsItemReceiptLinePackingVM" Property="@nameof(ReturnsItemReceiptLinePackingVM.QuantityBackOrdered)" Title="Back Ordered Quantity" />
                    <RadzenDataGridColumn TItem="ReturnsItemReceiptLinePackingVM" Property="@nameof(ReturnsItemReceiptLinePackingVM.QuantityBad)" Title="Quantity">
                        <Template Context="data">
                            <RadzenStack>
                                <RadzenFormField>
                                    <ChildContent>
                                        <RadzenNumeric Name="line_quantity_good" @bind-Value="@data.QuantityGood" Disabled="@(!data.IsReceived)" Max="@(data.QuantityOpen - data.QuantityBad)" Min="0" Format="#,##0.##" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenCustomValidator Component="line_quantity_good" Validator="@(() => data.QuantityOpen >= data.QuantityGood + data.QuantityBad)" Text="Cannot receive more than the open quantity" />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </AppTableWithSettings>
        </RadzenFieldset>
        <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Orientation="Orientation.Horizontal">
            <RadzenButton ButtonStyle="ButtonStyle.Light" ButtonType="ButtonType.Button" Click="@Return" Text="Return" />
            <RadzenButton ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit" Text="Submit" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {

    readonly DialogOptions dialogOptions = new()
    {
        CloseDialogOnOverlayClick = true,
        CloseDialogOnEsc = true,
        Draggable = true,
        Resizable = true,
        Width = "600px",
        ShowClose = true
    };
    
    async Task OpenBarcodeDialog(bool bad)
    {

        bool? save = await DialogService.OpenAsync(
                    "Table Settings",
                    ds => @<BarcodeScannerDialog BarcodeStore="BarcodeStore" Verifier="IsValidBarcode" />,
    options: dialogOptions);


        if (save == true)
            ApplyBarcodes(bad);
        else
            BarcodeStore.Clear();

        await InvokeAsync(StateHasChanged);
    }
}
