@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.ViewModels.Transaction.Packing.Returns

@inherits BaseComponent

<AppDataGrid @ref="@DataGrid" Id="packing_returns_grid" TItem="ReturnsPackingDataGridVM" DataGetter="@(gridReadyToLoad ? LoadDataAsync : null)" GridSettings="@DataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" AutoLoadGridSettings="false" ActionName="@ActionGetReturns">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="8px">
            <PrintStatusView @ref="PrintStatusView" Value="@SelectedPrintStatus" ValueChanged="@PrintStatusChanged" CountGetter="@PrintCountAsync" LoadCountsOnInitialize="false" RefreshCountsOnSelect="false" />
            <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
            <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
            <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="@RefreshPrintStatusAsync" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        <RadzenDataGridColumn TItem="ReturnsPackingDataGridVM"
                              Property="@nameof(ReturnsPackingDataGridVM.ReferenceNumber)"
                              Type="@typeof(string)"
                              Title="Reference Number" />
        <RadzenDataGridColumn TItem="ReturnsPackingDataGridVM"
                              Property="@nameof(ReturnsPackingDataGridVM.Date)"
                              Type="@typeof(DateTime)"
                              FormatString="{0:yyyy-MM-dd}"
                              Title="Transfer Order Date" />
        <RadzenDataGridColumn TItem="ReturnsPackingDataGridVM"
                              Property="@nameof(ReturnsPackingDataGridVM.SourceSubsidiary)"
                              Type="@typeof(string)"
                              Title="From Subsidiary" />
        <RadzenDataGridColumn TItem="ReturnsPackingDataGridVM"
                              Property="@nameof(ReturnsPackingDataGridVM.DestinationSubsidiary)"
                              Type="@typeof(string)"
                              Title="To Subsidiary" />
        <RadzenDataGridColumn TItem="ReturnsPackingDataGridVM"
                              Property="@nameof(ReturnsPackingDataGridVM.Location)"
                              Type="@typeof(string)"
                              Title="Source Warehouse" />
        <RadzenDataGridColumn TItem="ReturnsPackingDataGridVM"
                              Property="@nameof(ReturnsPackingDataGridVM.TransferLocation)"
                              Type="@typeof(string)"
                              Title="Destination Warehouse" />
        <RadzenDataGridColumn TItem="ReturnsPackingDataGridVM"
                              Property="@nameof(ReturnsPackingDataGridVM.Status)"
                              Type="@typeof(string)"
                              Title="Status" />
        <RadzenDataGridColumn TItem="ReturnsPackingDataGridVM"
                              Property="@nameof(ReturnsPackingDataGridVM.Remarks)"
                              Type="@typeof(string)"
                              Title="Remarks" />
        <RadzenDataGridColumn TItem="ReturnsPackingDataGridVM"
                              Frozen
                              FrozenPosition="FrozenColumnPosition.Right"
                              Pickable="false" Sortable="false" Filterable="false"
                               Width="112px">
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="4px">
                    @if (context.ForPrintingIFCount + context.PrintedIFCount == 1 && context.SingleFulfillmentId > 0)
                    {
                        <AppPrintLink Url="@NetSuitePrint.PackingLabel(context.SingleFulfillmentId)" RecordType="itemFulfillment" RecordId="@context.SingleFulfillmentId" OnPrint="@RefreshPrintStatusAsync" Size="ButtonSize.ExtraSmall" />
                    }
                    else
                    {
                        <RadzenButton Icon="print" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Disabled="@(context.ForPrintingIFCount + context.PrintedIFCount == 0)" title="@(context.ForPrintingIFCount + context.PrintedIFCount == 0 ? "No packing label available" : "Select a packing label")" Click="@(() => OpenPackingLabelsAsync(context.Id))" />
                    }
                    <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Visible="@(context.PendingPackLinesCount > 0)" Click="() => ViewReturn(context)" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="ReturnsPackingDataGridVM"
                                    @bind-Grid=@DataGrid.DataGrid
                                    @bind-GridSettings=@DataGridSettings />,
            options: GridSettingsService.GetDialogOptions());

        await DataGrid.DataGrid.Reload();
    }
}
