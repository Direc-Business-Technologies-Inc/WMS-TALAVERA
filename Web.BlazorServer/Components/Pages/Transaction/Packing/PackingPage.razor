@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.Components.Pages.Transaction.Packing
@using Web.BlazorServer.Components.Pages.Transaction.Packing.STR.Component
@using Web.BlazorServer.Components.Pages.Transaction.Packing.Returns.Component
@using Web.BlazorServer.Components.Pages.Transaction.Packing.VendorReturnAuthorization.Component
@using Web.BlazorServer.Components.Security

@inherits BaseComponent
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OPCK")]
@attribute [Route(PackingRoutes.Root)]

<PageTitle>Packing</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OPCK" />
</RadzenStack>

<AppContent>
    <RadzenTabs @bind-SelectedIndex="@SelectedTab" @bind-SelectedIndex:after="@TabChanged">
        <Tabs>
            <RadzenTabsItem Text="Stock Transfer Request">
                <STRPackingDataGrid />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Returns">
                <ReturnsPackingDataGrid />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Vendor Return Authorization">
                <VendorReturnAuthorizationPackingDataGrid />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Packed Item Fulfillments">
                <QuickDataGrid DataGetter="ItemFulfillmentsProvider" ActionWidth="72">
                    <RowActions>
                        <RadzenButton Icon="print" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light">
                            <RadzenLink Path="@PrintableURL(context)" Text="Print" target="_blank" Icon="print" />
                        </RadzenButton>
                    </RowActions>
                </QuickDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</AppContent>
