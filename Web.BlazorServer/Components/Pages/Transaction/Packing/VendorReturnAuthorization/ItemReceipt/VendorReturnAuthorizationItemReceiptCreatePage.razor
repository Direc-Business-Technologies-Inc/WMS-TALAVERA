@using Web.BlazorServer.Components.Pages.Transaction.Packing
@using Web.BlazorServer.Components.Pages.Transaction.Packing.VendorReturnAuthorization.ItemReceipt.Components
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.ViewModels.Transaction.Packing.VendorReturnAuthorization

@inherits BaseForm<VendorReturnAuthorizationItemReceiptPackingVM>
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OPCK")]
@attribute [Route(PackingRoutes.CreateVendorReturnAuthorizationItemReceipt)]

<PageTitle>Creating Vendor Return Authorization Item Receipt</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OPCK" />
</RadzenStack>

<AppContent>
    <AppFormSkeleton TItem="VendorReturnAuthorizationItemReceiptPackingVM" Loading="@IsLoadingData" />

    @if (!IsLoadingData)
    {
        <VendorReturnAuthorizationItemReceiptForm Data="@FormData" EditContext="@EditContext" OnValidSubmit="@OnValidSubmit" />
    }
</AppContent>
