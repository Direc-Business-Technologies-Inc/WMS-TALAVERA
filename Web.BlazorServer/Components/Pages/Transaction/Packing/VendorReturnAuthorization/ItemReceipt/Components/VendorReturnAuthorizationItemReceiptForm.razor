@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.Components.Pages.Transaction.Others.BarcodeScanning
@using Web.BlazorServer.ViewModels.Transaction.Packing.VendorReturnAuthorization
@inherits BaseComponent

<RadzenTemplateForm TItem="VendorReturnAuthorizationItemReceiptPackingVM" EditContext="@EditContext" Submit="@Submit">
    <RadzenStack Gap="0.5em">
        <RadzenFieldset Text="Details" AllowCollapse>
            <RadzenRow Gap="0.5em">
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Reference Number" class="rz-w-100">
                        <RadzenTextBox Value="@Data.CreatedFrom" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Date" class="rz-w-100">
                        <RadzenDatePicker @bind-Value="@Data.Date" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Subsidiary" class="rz-w-100">
                        <RadzenTextBox Value="@Data.Subsidiary" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Warehouse" class="rz-w-100">
                        <RadzenTextBox Value="@Data.Location" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Department" class="rz-w-100">
                        <RadzenTextBox Value="@Data.Department" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Vendor" class="rz-w-100">
                        <RadzenTextBox ReadOnly Value="@Data.Vendor" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenFieldset AllowCollapse Text="Lines">
            <AppTableWithSettings Data="@FulfillableLines" Id="packing_vendor_return_authorization_item_receipt_lines">

                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5em">
                        <RadzenButton Icon="barcode" ButtonStyle="ButtonStyle.Primary" Click="(() => OpenBarcodeDialog(false))" Size="ButtonSize.Small" Text="Scan Good Items" />
                        <RadzenButton Icon="barcode" ButtonStyle="ButtonStyle.Danger" Click="(() => OpenBarcodeDialog(true))" Size="ButtonSize.Small" Text="Scan Bad Items" />
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="VendorReturnAuthorizationItemReceiptLinePackingVM" Width="30px">
                        <Template Context="data">
                            <RadzenCheckBox @bind-Value="data.IsReceived" Disabled="data.IsComplete" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VendorReturnAuthorizationItemReceiptLinePackingVM" Property="@nameof(VendorReturnAuthorizationItemReceiptLinePackingVM.ItemCode)" Title="Item Code" />
                    <RadzenDataGridColumn TItem="VendorReturnAuthorizationItemReceiptLinePackingVM" Property="@nameof(VendorReturnAuthorizationItemReceiptLinePackingVM.ItemDescription)" Title="Item Description" />
                    <RadzenDataGridColumn TItem="VendorReturnAuthorizationItemReceiptLinePackingVM" Property="@nameof(VendorReturnAuthorizationItemReceiptLinePackingVM.UoM)" Title="UoM" />
                    <RadzenDataGridColumn TItem="VendorReturnAuthorizationItemReceiptLinePackingVM" Property="@nameof(VendorReturnAuthorizationItemReceiptLinePackingVM.Location)" Title="Warehouse" />
                    <RadzenDataGridColumn TItem="VendorReturnAuthorizationItemReceiptLinePackingVM" Property="@nameof(VendorReturnAuthorizationItemReceiptLinePackingVM.QuantityPlanned)" Title="Planned Quantity" />
                    <RadzenDataGridColumn TItem="VendorReturnAuthorizationItemReceiptLinePackingVM" Property="@nameof(VendorReturnAuthorizationItemReceiptLinePackingVM.QuantityReceived)" Title="Received Quantity" />
                    <RadzenDataGridColumn TItem="VendorReturnAuthorizationItemReceiptLinePackingVM" Property="@nameof(VendorReturnAuthorizationItemReceiptLinePackingVM.QuantityBad)" Title="Quantity">
                        <Template Context="data">
                            <RadzenStack>
                                <RadzenFormField>
                                    <TextTemplate>
                                        <RadzenText class="@(data.IsReceived ? "rz-color-success" : "rz-color-base-300")" Text="Good" TextStyle="TextStyle.Caption" />
                                    </TextTemplate>
                                    <ChildContent>
                                        <RadzenNumeric Name="line_quantity_good" @bind-Value="@data.QuantityGood" Disabled="@(!data.IsReceived)" Max="@(data.QuantityOpen - data.QuantityBad)" Min="0" Format="#,##0.##" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenCustomValidator Component="line_quantity_good" Validator="@(() => data.QuantityOpen >= data.QuantityGood + data.QuantityBad)" Text="Cannot receive more than the open quantity" />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VendorReturnAuthorizationItemReceiptLinePackingVM" Title="Bad Quantity">
                        <Template Context="data">
                            <RadzenFormField>
                                <TextTemplate>
                                    <RadzenText class="@(data.IsReceived ? "rz-color-danger" : "rz-color-base-300")" Text="Bad" TextStyle="TextStyle.Caption" />
                                </TextTemplate>
                                <ChildContent>
                                    <RadzenNumeric Name="line_quantity_bad" @bind-Value="@data.QuantityBad" Disabled="@(!data.IsReceived)" Max="@(data.QuantityOpen - data.QuantityGood)" Min="0" Format="#,##0.##" />
                                </ChildContent>
                                <Helper>
                                    <RadzenCustomValidator Component="line_quantity_bad" Validator="@(() => data.QuantityOpen >= data.QuantityGood + data.QuantityBad)" Text="Cannot receive more than the open quantity" />
                                </Helper>
                            </RadzenFormField>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </AppTableWithSettings>
        </RadzenFieldset>
        <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Orientation="Orientation.Horizontal">
            <RadzenButton ButtonStyle="ButtonStyle.Light" ButtonType="ButtonType.Button" Click="@Return" Text="Return" />
            <RadzenButton ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit" Text="Submit" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {

    readonly DialogOptions dialogOptions = new()
    {
        CloseDialogOnOverlayClick = true,
        CloseDialogOnEsc = true,
        Draggable = true,
        Resizable = true,
        Width = "600px",
        ShowClose = true
    };
    
    async Task OpenBarcodeDialog(bool bad)
    {

        bool? save = await DialogService.OpenAsync(
                    "Table Settings",
                    ds => @<BarcodeScannerDialog BarcodeStore="BarcodeStore" Verifier="IsValidBarcode" />,
    options: dialogOptions);


        if (save == true)
            ApplyBarcodes(bad);
        else
            BarcodeStore.Clear();

        await InvokeAsync(StateHasChanged);
    }
}