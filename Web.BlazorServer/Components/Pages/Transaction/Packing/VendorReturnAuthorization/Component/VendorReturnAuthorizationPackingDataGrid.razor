@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Transaction.Packing.VendorReturnAuthorization

@inherits BaseComponent

<AppDataGrid @ref="@DataGrid" Id="packing_vendor_return_authorization_grid" TItem="VendorReturnAuthorizationPackingDataGridVM" DataGetter="@LoadDataAsync" GridSettings="@DataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" ActionName="@ActionGetVendorReturnAuthorizations">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
            <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
            <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="DataGrid.ReloadDataAsync" />
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.ReferenceNumber)"
                              Type="@typeof(string)"
                              Title="Reference Number" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.Date)"
                              Type="@typeof(DateTime)"
                              FormatString="{0:yyyy-MM-dd}"
                              Title="Date" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.SourceSubsidiary)"
                              Type="@typeof(string)"
                              Title="Subsidiary" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.Location)"
                              Type="@typeof(string)"
                              Title="Source Warehouse" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.Status)"
                              Type="@typeof(string)"
                              Title="Status" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.Remarks)"
                              Type="@typeof(string)"
                              Title="Remarks" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Frozen
                              FrozenPosition="FrozenColumnPosition.Right"
                              Pickable="false" Sortable="false" Filterable="false"
                              Width="35px">
            <Template>
                <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Click="() => ViewVendorReturnAuthorization(context)" />
            </Template>
        </RadzenDataGridColumn>
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="VendorReturnAuthorizationPackingDataGridVM"
                                    @bind-Grid=@DataGrid.DataGrid
                                    @bind-GridSettings=@DataGridSettings />,
            options: GridSettingsService.GetDialogOptions());

        await DataGrid.DataGrid.Reload();
    }
}
