@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.ViewModels.Transaction.Packing.VendorReturnAuthorization

@inherits BaseComponent

<AppDataGrid @ref="@DataGrid" Id="packing_vendor_return_authorization_grid" TItem="VendorReturnAuthorizationPackingDataGridVM" DataGetter="@(gridReadyToLoad ? LoadDataAsync : null)" GridSettings="@DataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" AutoLoadGridSettings="false" ActionName="@ActionGetVendorReturnAuthorizations">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="8px">
            <PrintStatusView @ref="PrintStatusView" Value="@SelectedPrintStatus" ValueChanged="@PrintStatusChanged" CountsGetter="@PrintCountsAsync" LoadCountsOnInitialize="false" RefreshCountsOnSelect="false" />
            <RadzenStack Orientation="Orientation.Horizontal" Gap="8px">
            <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
            <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="@RefreshPrintStatusAsync" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.ReferenceNumber)"
                              Type="@typeof(string)"
                              Title="Reference Number" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.Date)"
                              Type="@typeof(DateTime)"
                              FormatString="{0:yyyy-MM-dd}"
                              Title="Date" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.SourceSubsidiary)"
                              Type="@typeof(string)"
                              Title="Subsidiary" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.Location)"
                              Type="@typeof(string)"
                              Title="Source Warehouse" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.Status)"
                              Type="@typeof(string)"
                              Title="Status" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Property="@nameof(VendorReturnAuthorizationPackingDataGridVM.Remarks)"
                              Type="@typeof(string)"
                              Title="Remarks" />
        <RadzenDataGridColumn TItem="VendorReturnAuthorizationPackingDataGridVM"
                              Frozen
                              FrozenPosition="FrozenColumnPosition.Right"
                              Pickable="false" Sortable="false" Filterable="false"
                               Width="112px">
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="4px">
                    <Web.BlazorServer.Components.Pages.Transaction.Packing.Components.PackingLabelRowPrint TransactionId="@context.Id" Source="VRA" SelectedPrintStatus="@SelectedPrintStatus" FulfillmentCount="@(context.ForPrintingIFCount + context.PrintedIFCount)" SingleFulfillmentId="@context.SingleFulfillmentId" OnPrinted="@RefreshPrintStatusAsync" />
                    <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Visible="@(context.PendingPackLinesCount > 0)" Click="() => ViewVendorReturnAuthorization(context)" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="VendorReturnAuthorizationPackingDataGridVM"
                                    @bind-Grid=@DataGrid.DataGrid
                                    @bind-GridSettings=@DataGridSettings />,
            options: GridSettingsService.GetDialogOptions());

        await DataGrid.DataGrid.Reload();
    }
}
