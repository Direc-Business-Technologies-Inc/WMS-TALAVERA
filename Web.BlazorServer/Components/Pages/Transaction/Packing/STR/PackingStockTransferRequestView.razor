@using Mapster
@using Web.BlazorServer.Components.Pages.Transaction.Packing
@using Web.BlazorServer.Components.Pages.Transaction.Packing.STR.Component
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.Defaults
@using Web.BlazorServer.Handlers.Repositories.Transaction.Packing.STR
@using Web.BlazorServer.ViewModels.Transaction.Packing.STR

@inherits BaseForm<StockTransferRequestInfoPackingVM>
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OPCK")]
@attribute [Route(PackingRoutes.StockTransferRequestView)]

<PageTitle>Packing Stock Transfer Request</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OPCK" />
</RadzenStack>

<AppContent>
    <AppFormSkeleton TItem="StockTransferRequestInfoPackingVM" Loading="@IsLoadingData" />
    @if (!IsLoadingData)
    {
        <STRPackingForm Model="@FormData" EditContext="@EditContext" ReadOnly ReturnURI="@PackingRoutes.Root" />
    }
</AppContent>

@code {
    [Inject] IStockTransferRequestPackingHandler handler { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? Ref { get; set; }

    bool IsLoadingData => AppBusyService.IsBusy(ActionGetStockTransferRequest);

    readonly string ActionGetStockTransferRequest = "Get Packing Stock Transfer Request";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (string.IsNullOrEmpty(Ref)) NavError("Please select a packing stock transfer request from the list");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            AppBusyService.SetBusy(ActionGetStockTransferRequest, true);
            await InvokeAsync(StateHasChanged);
            await LoadDataAsync();
        }
    }

    async Task LoadDataAsync()
    {
        var action = await AppActionFactory.RunAsync(async () =>
        {
            if (string.IsNullOrEmpty(Ref)) throw new Exception("Please select a packing stock transfer request from the list");

            var response = await handler.GetPackingStockTransferRequest(Ref);

            if (response is null) throw new Exception($"Packing stock transfer request \"{Ref}\" could not be found");

            return response;
        }, AppActionOptionPresets.Loading(ActionGetStockTransferRequest));

        action.OnSuccess(async res =>
        {
            res.Adapt(FormData);
            FormData.Category = res.Category;
            await InvokeAsync(StateHasChanged);
        });

        action.OnFailure(ex =>
        {
            NavError(ex.Message);
            return Task.CompletedTask;
        });
    }

    void NavError(string message)
    {
        ToastService.Error(message);
        NavManager.NavigateTo(PackingRoutes.Root);
    }

    protected override Task InitializeEditing() => throw new NotImplementedException();
    protected override Task CancelEditing() => throw new NotImplementedException();
    protected override Task HandleSubmit() => throw new NotImplementedException();
}
