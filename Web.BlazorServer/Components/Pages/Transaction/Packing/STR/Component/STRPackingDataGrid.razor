@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Administration.User
@using Web.BlazorServer.ViewModels.Transaction.Packing.STR

@inherits BaseComponent

<AppDataGrid @ref="@DataGrid" Id="packing_str_grid" TItem="StockTransferRequestPackingDataGridVM" DataGetter="@LoadDataAsync" GridSettings="@DataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" ActionName="@ActionGetStockTransferRequests">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="8px">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="8px">
                <RadzenFormField Text="Filter By Status">
                    <QuickVirtualizedDropdown TItem="TransferOrderStatusPackingVM" ActionName="@ActionGetTranferOrderStatuses" DataGetter="@TranferOrderStatusProvider" TextProperty="@nameof(TransferOrderStatusPackingVM.Name)" @bind-Value:get="@StatusFilter" @bind-Value:set="@StatusFilterChanged" />
                </RadzenFormField>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                <RadzenButton Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="AddButtonPressed" Visible="@OnAddClicked.HasDelegate" />
                <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="DataGrid.ReloadDataAsync" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        <RadzenDataGridColumn TItem="StockTransferRequestPackingDataGridVM"
                              Property="@nameof(StockTransferRequestPackingDataGridVM.ReferenceNumber)"
                              Title="Reference Number" />
        <RadzenDataGridColumn TItem="StockTransferRequestPackingDataGridVM"
                              Property="@nameof(StockTransferRequestPackingDataGridVM.Date)"
                              Type="@typeof(DateTime)"
                              FormatString="{0:yyyy-MM-dd}"
                              Title="Date" />
        <RadzenDataGridColumn TItem="StockTransferRequestPackingDataGridVM"
                              Property="@nameof(StockTransferRequestPackingDataGridVM.StatusDisplayString)"
                              Type="@typeof(string)"
                              Title="Status" />
        <RadzenDataGridColumn TItem="StockTransferRequestPackingDataGridVM"
                              Property="@nameof(StockTransferRequestPackingDataGridVM.SourceLocation)"
                              Type="@typeof(string)"
                              Title="From Location" />
        <RadzenDataGridColumn TItem="StockTransferRequestPackingDataGridVM"
                              Property="@nameof(StockTransferRequestPackingDataGridVM.DestinationLocation)"
                              Type="@typeof(string)"
                              Title="To Location" />
        <RadzenDataGridColumn TItem="StockTransferRequestPackingDataGridVM"
                              Property="@nameof(StockTransferRequestPackingDataGridVM.Subsidiary)"
                              Type="@typeof(string)"
                              Title="From Subsidiary" />
        <RadzenDataGridColumn TItem="StockTransferRequestPackingDataGridVM"
                              Property="@nameof(StockTransferRequestPackingDataGridVM.ToSubsidiary)"
                              Type="@typeof(string)"
                              Title="To Subsidiary" />
        <RadzenDataGridColumn TItem="StockTransferRequestPackingDataGridVM"
                              Property="@nameof(StockTransferRequestPackingDataGridVM.PreparedBy)"
                              Type="@typeof(string)"
                              Title="Prepared By" />
        <RadzenDataGridColumn TItem="StockTransferRequestPackingDataGridVM"
                              Property="@nameof(StockTransferRequestPackingDataGridVM.Remarks)"
                              Type="@typeof(string)"
                              Title="Remarks" />
        <RadzenDataGridColumn TItem="StockTransferRequestPackingDataGridVM"
                              Frozen
                              FrozenPosition="FrozenColumnPosition.Right"
                              Width="35px">
            <Template>
                <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Click="() => ViewSTR(context)" />
            </Template>
        </RadzenDataGridColumn>
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="StockTransferRequestPackingDataGridVM"
            @bind-Grid=@DataGrid.DataGrid
            @bind-GridSettings=@DataGridSettings />,
            options: GridSettingsService.GetDialogOptions());

        await DataGrid.DataGrid.Reload();
    }
}
