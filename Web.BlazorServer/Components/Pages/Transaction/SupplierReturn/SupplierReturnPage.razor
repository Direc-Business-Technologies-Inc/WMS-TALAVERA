@using Web.BlazorServer.Components.Pages.Transaction.SupplierReturn.Components
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Transaction.SupplierReturn
@inherits BaseComponent
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OSRN")]
@attribute [Route(SupplierReturnRoutes.INDEX)]



<PageTitle>Return to Supplier</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OSRN" />
</RadzenStack>

<AppContent>
    <RadzenTabs @bind-SelectedIndex="SelectedTab">
        <Tabs>
            <RadzenTabsItem Text="All">
                @if (SelectedTab == 0) { <SupplierReturnsDataGrid RowAction="OnRowAction" /> }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Bulk Fulfillment Status">
                @if (SelectedTab == 1) { <BulkFulfillmentStatusGrid /> }
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</AppContent>


@code {
    int SelectedTab;
    async Task OnRowAction(SupplierReturnDataGridVM data)
    {
        NavManager.NavigateTo(SupplierReturnRoutes.VIEW + $"?ref={data.ReferenceNumber}", true);
    }
}
