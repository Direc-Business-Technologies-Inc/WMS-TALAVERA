@using Application.DataTransferObjects.Transactions.SupplierReturn
@using Web.BlazorServer.ViewModels.Transaction.SupplierReturn
@using Web.BlazorServer.Handlers.Repositories.Transaction.SupplierReturn
@using Web.BlazorServer.Components.Custom
@using global::Shared.Entities
@inject ISupplierReturnHandler ReturnHandler
@inject Radzen.DialogService DialogService

<QuickDataGrid @ref="Grid" TItem="BulkFulfillmentStatusDTO" Id="rts_bulk_fulfillment_status" ActionName="Bulk Fulfillment Status"
               DataGetter="LoadAsync" ActionWidth="55">
    <HeaderEnd>
        <RadzenButton Icon="refresh" Size="ButtonSize.Small" Click="RefreshAsync" title="Refresh status" />
    </HeaderEnd>
    <HeaderStart>
        <GridDateRange StartDate="DateRangeStart" EndDate="DateRangeEnd" OnApply="DateRangeChanged" />
    </HeaderStart>
    <Columns>
        <RadzenDataGridColumn TItem="BulkFulfillmentStatusDTO" Property="Date" Title="Date" FormatString="{0:MMMM dd, yyyy}" />
        <RadzenDataGridColumn TItem="BulkFulfillmentStatusDTO" Property="Memo" Title="Memo" />
        <RadzenDataGridColumn TItem="BulkFulfillmentStatusDTO" Property="Status" Title="Status" />
    </Columns>
    <RowActions>
        <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" title="View bulk fulfillment request"
                      Click="@(() => ViewAsync(context))" />
    </RowActions>
</QuickDataGrid>

@code {
    private QuickDataGrid<BulkFulfillmentStatusDTO> Grid = default!;
    private DateTime? DateRangeStart;
    private DateTime? DateRangeEnd;

    private Task<(IEnumerable<BulkFulfillmentStatusDTO> Data, int Count)> LoadAsync(global::Shared.Entities.DataGridIntent intent)
    {
        if (DateRangeStart.HasValue && DateRangeEnd.HasValue)
            PrintStatusFilter.ApplyDateRange(intent, DateRangeStart, DateRangeEnd);
        return ReturnHandler.GetBulkFulfillmentStatusesAsync(intent);
    }

    private async Task DateRangeChanged((DateTime Start, DateTime End) range)
    {
        DateRangeStart = range.Start;
        DateRangeEnd = range.End;
        await Grid.ReloadFirstPage();
    }

    private Task RefreshAsync() => Grid.Reload();

    private async Task ViewAsync(BulkFulfillmentStatusDTO request)
    {
        var rows = await ReturnHandler.GetBulkFulfillmentReturnsAsync(request.Id);
        await DialogService.OpenAsync("RTS List", ds => builder =>
        {
            builder.OpenComponent<BulkFulfillConfirmation>(0);
            builder.AddAttribute(1, nameof(BulkFulfillConfirmation.Rows), rows);
            builder.AddAttribute(2, nameof(BulkFulfillConfirmation.ReadOnly), true);
            builder.AddAttribute(3, nameof(BulkFulfillConfirmation.ErrorMessage), request.ErrorMessage);
            builder.CloseComponent();
        }, new() { Width = "700px" });
    }
}
