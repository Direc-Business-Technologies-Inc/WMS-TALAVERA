@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.ViewModels.Transaction.SupplierReturn
@inherits BaseComponent 

<PrintStatusView @ref="PrintStatusView" Value="@SelectedPrintStatus" ValueChanged="@PrintStatusChanged" CountGetter="@PrintCountAsync" />
<QuickDataGrid @ref="@Grid" DataGetter="@LoadDataAsync" ActionName="@ActionGetReturnsToSupplier" Id="returns_to_supplier_datagrid" ActionWidth="55">
    <HeaderStart>
        <RadzenFormField Text="Filter by Status" Style="margin-top:-10px!important">
            <QuickVirtualizedDropdown TItem="ReturnStatusVM" DataGetter="StatusProvider" @bind-Value:get="@FilterStatus" @bind-Value:set="FilterSet" TextProperty="@nameof(ReturnStatusVM.Name)"/>
        </RadzenFormField>
        <GridDateRange StartDate="@DateRangeStart" EndDate="@DateRangeEnd" OnApply="@DateRangeChanged" />
    </HeaderStart>
    <HeaderEnd>
        <RadzenButton Icon="add" Size="ButtonSize.Small" Click="@(() => NavManager.NavigateTo(SupplierReturnRoutes.CREATE))" ButtonStyle="ButtonStyle.Success" />
        <RadzenButton Icon="content_copy" Text="Bulk Fulfill" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success"
                      Disabled="@(SelectedRows.Count < 2)" Click="@OpenBulkFulfillConfirmation" />
    </HeaderEnd>
    <Columns>
        <RadzenDataGridColumn TItem="SupplierReturnDataGridVM" Width="55px" Filterable="false" Sortable="false" Pickable="false">
            <HeaderTemplate>
                <RadzenCheckBox TValue="bool" Value="@AllVisibleSelected" Change="@ToggleAllVisible" Name="rts_select_all" />
            </HeaderTemplate>
            <Template Context="row">
                <RadzenCheckBox TValue="bool" Value="@(SelectedRows.ContainsKey(row.Id))"
                                Change="@(selected => ToggleRow(row, selected))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="SupplierReturnDataGridVM" Property="ReferenceNumber" Title="Document Number" />
        <RadzenDataGridColumn TItem="SupplierReturnDataGridVM" Property="Date" Title="Date" FormatString="{0:MMMM dd, yyyy}" />
        <RadzenDataGridColumn TItem="SupplierReturnDataGridVM" Property="VendorName" Title="Vendor" />
        <RadzenDataGridColumn TItem="SupplierReturnDataGridVM" Property="CreatedFrom" Title="Created From" />
        <RadzenDataGridColumn TItem="SupplierReturnDataGridVM" Property="CategoryName" Title="Category" />
        <RadzenDataGridColumn TItem="SupplierReturnDataGridVM" Property="Memo" Title="Remarks" />
        <RadzenDataGridColumn TItem="SupplierReturnDataGridVM" Property="PreparedBy" Title="Prepared By" />
        <RadzenDataGridColumn TItem="SupplierReturnDataGridVM" Property="StatusName" Title="Status" />
    </Columns>
    <RowActions>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="4px" JustifyContent="JustifyContent.End">
            <AppPrintLink Url="@PrintUrl(context)" RecordType="vendorReturnAuthorization" RecordId="@context.Id" OnPrint="@RefreshPrintStatusAsync" Size="ButtonSize.ExtraSmall" />
            <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Click="() => OnRowAction(context)" />
        </RadzenStack>
    </RowActions>
</QuickDataGrid>
