@using Web.BlazorServer.Components.Pages.Transaction.SupplierReturn.Components
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.ViewModels.Transaction.SupplierReturn

@inherits BaseForm<SupplierReturnVM>
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OSRN")]
@attribute [Route(SupplierReturnRoutes.VIEW)]


<PageTitle>Return to Supplier: @Ref</PageTitle>


<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OSRN" />
</RadzenStack>

<AppContent>
    <RadzenStack Visible="@(!IsLoadingData)" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack Orientation="Orientation.Horizontal">
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.End"
                     Gap="32px"
                     class="rz-mb-0 rz-mt-2">
            <AppContentBadge Visible="@(!string.IsNullOrEmpty(FormData.CreatedFrom))" Title="From" Content="@FormData.CreatedFrom" />
            <AppContentBadge Title="Doc" Content="@FormData.ReferenceNumber" />
            <AppContentBadge Title="Doc Date" Content="@FormData.Date.ToString("MM-dd-yy")" ChildBadgeStyle="BadgeStyle.Secondary" ChildShade="Shade.Default" />
        </RadzenStack>
    </RadzenStack>
    <AppFormSkeleton Loading="@IsLoadingData" TItem="SupplierReturnVM" />
    @if (!IsLoadingData)
    {
        <SupplierReturnForm Model="@FormData" EditContext="@EditContext" ReadOnly OnReturn="@Return" />
    }
</AppContent>
