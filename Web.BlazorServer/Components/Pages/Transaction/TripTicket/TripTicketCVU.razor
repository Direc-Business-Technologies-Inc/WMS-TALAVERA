@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.ViewModels.Transaction.TripTicket

@inherits BaseComponent
@layout ProtectedLayout
@attribute [Route(TripTicketRoutes.Create)]
@attribute [Route(TripTicketRoutes.View)]
@attribute [AppAuthorizationAttribute("VIEW", "OTTX")]

<PageTitle>@(Creating ? "New Trip Ticket" : $"Trip Ticket {Ref}")</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OTTX" AdditionalRoutes="@AdditionalRoutes" />
</RadzenStack>

<AppContent>
    <AppFormSkeleton TItem="TripTicketDataGridVM" Loading="@IsLoadingData" />

    @if (!IsLoadingData && Creating)
    {
        <RadzenStack Gap="1rem">
            <RadzenText Text="Create Trip Ticket" TextStyle="TextStyle.H5" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start">
                <RadzenButton Text="Back" ButtonStyle="ButtonStyle.Base" Click="@Back" />
            </RadzenStack>
        </RadzenStack>
    }
    else if (!IsLoadingData && Viewing && TripTicket is not null)
    {
        <RadzenStack Gap="0.5em" class="rz-p-3">
            <RadzenFieldset Text="Details" AllowCollapse>
                <ChildContent>
                    <RadzenStack Gap="1rem">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="TTX No." class="rz-w-100" AllowFloatingLabel="false">
                                    <RadzenTextBox ReadOnly Value="@TripTicket.NetsuiteTripTicketInternalId.ToString()" class="rz-w-100" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Name" class="rz-w-100" AllowFloatingLabel="false">
                                    <RadzenTextBox ReadOnly Value="@TripTicket.Name" class="rz-w-100" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Trip Date" class="rz-w-100" AllowFloatingLabel="false">
                                    <RadzenTextBox ReadOnly Value="@TripTicket.TripDate?.ToString("MM/dd/yyyy")" class="rz-w-100" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Destination" class="rz-w-100" AllowFloatingLabel="false">
                                    <RadzenTextBox ReadOnly Value="@TripTicket.Destination" class="rz-w-100" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Driver" class="rz-w-100" AllowFloatingLabel="false">
                                    <RadzenTextBox ReadOnly Value="@TripTicket.Driver" class="rz-w-100" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Origin Location" class="rz-w-100" AllowFloatingLabel="false">
                                    <RadzenTextBox ReadOnly Value="@TripTicket.Location" class="rz-w-100" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </ChildContent>
            </RadzenFieldset>
            <RadzenFieldset Text="Lines" AllowCollapse>
            </RadzenFieldset>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start">
                <RadzenButton Text="Back" ButtonStyle="ButtonStyle.Base" Click="@Back" />
            </RadzenStack>
        </RadzenStack>
    }
</AppContent>
