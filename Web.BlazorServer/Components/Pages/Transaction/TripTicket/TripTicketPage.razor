@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.Components.Pages.Transaction.TripTicket.Component
@using Web.BlazorServer.Components.Security

@inherits BaseComponent
@page "/transactions/delivery/trip-ticket"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OTTX")]

<PageTitle>Trip Ticket</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OTTX" />
</RadzenStack>

<AppContent>
    <RadzenTabs SelectedIndex="0">
        <Tabs>
            <RadzenTabsItem Text="Trip Tickets">
                <PrintStatusView Disabled="true" />
                <p class="rz-text-secondary rz-mb-2">Print status is awaiting the NetSuite field mapping for Trip Tickets. Showing all tickets.</p>
                <TripTicketDataGrid />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</AppContent>
