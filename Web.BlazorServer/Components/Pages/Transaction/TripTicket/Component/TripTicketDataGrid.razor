@using Web.BlazorServer.ViewModels.Transaction.TripTicket
@using Web.BlazorServer.Components.Custom
@inherits BaseComponent

<PrintStatusView @ref="PrintStatusView" Value="@SelectedPrintStatus" ValueChanged="@PrintStatusChanged" CountGetter="@PrintCountAsync" LoadCountsOnInitialize="false" />
<GridDateRange StartDate="@DateRangeStart" EndDate="@DateRangeEnd" OnApply="@DateRangeChanged" />
<AppDataGrid @ref="@TTDataGrid" Id="trip_ticket_grid" TItem="TripTicketDataGridVM" DataGetter="@LoadDataAsync" GridSettings="@TTDataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" AutoLoadGridSettings="false" ActionName="@ActionGetTripTickets">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="@RefreshPrintStatusAsync" />
                <RadzenButton Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@CreateTT" Visible="@(Can.Create("OTTX"))" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        <RadzenDataGridColumn TItem="TripTicketDataGridVM"
                              Property="@nameof(TripTicketDataGridVM.Name)"
                              Type="@typeof(string)"
                              Title="Name" />
        <RadzenDataGridColumn TItem="TripTicketDataGridVM"
                              Property="@nameof(TripTicketDataGridVM.TripDate)"
                              Type="@typeof(DateTime)"
                              Title="Trip Date">
            <Template>
                @context.TripDate?.ToString("MMMM dd, yyyy")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="TripTicketDataGridVM"
                              Property="@nameof(TripTicketDataGridVM.Location)"
                              Type="@typeof(string)"
                              Title="Origin Location" />
        <RadzenDataGridColumn TItem="TripTicketDataGridVM"
                              Property="@nameof(TripTicketDataGridVM.Destination)"
                              Type="@typeof(string)"
                              Title="Destination" />
        <RadzenDataGridColumn TItem="TripTicketDataGridVM"
                              Property="@nameof(TripTicketDataGridVM.Driver)"
                              Type="@typeof(string)"
                              Title="Driver" />
        <RadzenDataGridColumn TItem="TripTicketDataGridVM"
                              Frozen
                              FrozenPosition="FrozenColumnPosition.Right"
                              Width="72px"
                              Filterable="false" Sortable="false" Pickable="false">
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="4px">
                    <AppPrintLink Url="@NetSuitePrint.TripTicket(context.NetsuiteTripTicketInternalId)" RecordType="customrecord_dbti_trip_ticket" RecordId="@context.NetsuiteTripTicketInternalId" OnPrint="@RefreshAfterPrintAsync" Size="ButtonSize.ExtraSmall" />
                    <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Click="() => ViewTT(context)" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="TripTicketDataGridVM"
            @bind-Grid=@TTDataGrid.DataGrid
            @bind-GridSettings=@TTDataGridSettings />,
            options: GridSettingsService.GetDialogOptions());

        await TTDataGrid.DataGrid.Reload();
    }
}
