@using global::Shared.Libraries.ViewModel.TripTicket
@using global::Shared.Libraries.ViewModel.ItemFulfillment

@inherits BaseComponent

<RadzenStack Gap="2rem">
    <AppDataGrid @ref="@FulfillmentsDataGrid"
                 Id="trip_ticket_fulfillment_selection_grid"
                 TItem="ItemFulfillmentVM"
                 GridSettings="@FulfillmentsDataGridSettings"
                 @bind-GridSettingsLoaded="@GridSettingsLoaded"
                 DataGetter="@LoadDataAsync"
                 ActionName="@ActionGetFulfillments"
                 SelectedItems="@SelectedFulfillments"
                 DataGridSelectionMode="DataGridSelectionMode.Multiple">
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="8px">
                <!-- Search -->
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="4px">

                    <RadzenTextBox @bind-Value="@SearchText"
                                   Placeholder="Search items..."
                                   Style="width: 250px;"
                                   Change="@OnSearchChanged" />

                    @if (!string.IsNullOrWhiteSpace(SearchText))
                    {
                        <RadzenButton Icon="close"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="@ClearSearch" />
                    }

                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="4px">
                    <SelectAllHeader Value="@GetSelectionHeaderState()"
                                     OnChange="@ToggleAllItems"
                                     ShowCheckbox="false" />
                    <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                    <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="FulfillmentsDataGrid.ReloadDataAsync" />
                </RadzenStack>
            </RadzenStack>
        </HeaderTemplate>
        <GridColumns>
            <RadzenDataGridColumn TItem="ItemFulfillmentVM"
                                  Frozen
                                  FrozenPosition="FrozenColumnPosition.Right"
                                  Width="35px"
                                  Filterable="false" Sortable="false" Pickable="false">
                <HeaderTemplate>
                    <SelectAllHeader Value="@GetSelectionHeaderState()"
                                     OnChange="@ToggleAllItems"
                                     ShowButton="false"
                                     CheckboxName="trip_ticket_fulfillment_selection_select_all" />
                </HeaderTemplate>
                <Template>
                    <RadzenCheckBox TValue="bool"
                                    Value="@(SelectedFulfillments.Any(x => x.OrderNumber == context.OrderNumber))"
                                    Change="@(_ => SelectItem(context))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemFulfillmentVM"
                                  Title="Fulfillment No."
                                  Property="@nameof(ItemFulfillmentVM.OrderNumber)"
                                  Type="@typeof(string)" />
            <RadzenDataGridColumn TItem="ItemFulfillmentVM"
                                  Title="Status"
                                  Property="@nameof(ItemFulfillmentVM.OrderStatus)"
                                  Type="@typeof(string)">
                <Template Context="line">
                    @line.GetName(line.OrderStatus)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemFulfillmentVM"
                                  Title="Created Date"
                                  Property="@nameof(ItemFulfillmentVM.NetsuiteOrderCreatedDate)"
                                  Type="@typeof(DateTime)">
                <Template Context="line">
                    @line.NetsuiteOrderCreatedDate.ToString("MM/dd/yyyy")
                </Template>
            </RadzenDataGridColumn>
        </GridColumns>
    </AppDataGrid>
</RadzenStack>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="ItemFulfillmentVM"
                                    @bind-Grid=@FulfillmentsDataGrid.DataGrid
                                    @bind-GridSettings=@FulfillmentsDataGridSettings />,
            options: GridSettingsService.GetDialogOptions());
        await FulfillmentsDataGrid.DataGrid.Reload();
    }
}
