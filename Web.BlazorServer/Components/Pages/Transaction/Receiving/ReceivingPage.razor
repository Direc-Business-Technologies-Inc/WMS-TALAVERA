@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.Components.Pages.Transaction.Receiving.Components
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Administration.User
@using Web.BlazorServer.ViewModels.Transaction.Receiving

@inherits BaseComponent
@page "/transactions/purchasing/receiving"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "ORCV")]


<PageTitle>Receiving</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="ORCV" />
</RadzenStack>

<AppContent>
    <RadzenTabs @bind-SelectedIndex="@SelectedTab" @bind-SelectedIndex:after="@TabChanged">
        <Tabs>
            <RadzenTabsItem Text="Purchase Orders">
                <PurchaseOrderGrid />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Stock Transfer Request">
                <TransferOrderGrid />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Returns">
                <ReturnsGrid />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Receiving Reports">
                <QuickDataGrid Id="ir_item_receipts_grid" DataGetter="ItemReceiptsProvider" ActionWidth="72">
                    <RowActions>
                        <RadzenButton Icon="print" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light">
                            <RadzenLink Path="@PrintableURL(context)" Text="Print" target="_blank" Icon="print" />
                        </RadzenButton>
                    </RowActions>
                </QuickDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</AppContent>