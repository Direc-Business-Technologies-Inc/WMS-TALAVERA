@using Domain.Entities.Enums.Transaction.Receiving
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.ViewModels.Others
@using Web.BlazorServer.ViewModels.Transaction.Receiving

@inherits BaseForm<PurchaseOrderVM>
@page "/transactions/purchasing/receiving/purchase-order/view"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "ORCV")]

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="ORCV" AdditionalRoutes="@AdditionalRoutes" />
</RadzenStack>
<AppContent>

    <AppFormSkeleton TItem="PurchaseOrderVM" Loading="@IsLoadingData" />

    <RadzenStack Visible="@(!IsLoadingData)"
                 Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.End"
                 Gap="32px"
                 class="rz-mb-2">
        <AppContentBadge Title="Doc" Content="@FormData.ReferenceNumber" />
        <AppContentBadge Title="Doc Date" Content="@FormData.Date.ToString("MM-dd-yy")" ChildBadgeStyle="BadgeStyle.Secondary" ChildShade="Shade.Default" />
        <AppContentBadge Title="Doc Due Date" Content="@FormData.DeliveryDate.ToString("MM-dd-yy")" ChildBadgeStyle="BadgeStyle.Secondary" ChildShade="Shade.Default" />
    </RadzenStack>

    <RadzenTemplateForm @ref="@TemplateForm" TItem="PurchaseOrderVM" @bind-Data="@FormData" >
        <RadzenStack Gap="1rem">
            <RadzenFieldset AllowCollapse Text="Details">
                <ChildContent>
                    <RadzenStack Gap="0.5rem">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Vendor Code." class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Value="@FormData.VendorCode" Placeholder="VENDOR-1001" Name="po_card_code" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Vendor Name" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Value="@FormData.VendorName" Placeholder="VENDOR ABC" Name="po_card_name" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Status" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Value="@(string.IsNullOrEmpty(FormData.Status) ? "N/A" : FormData.StatusDescription)" Placeholder="USER DEF" Name="po_status" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Remarks" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Value="@(string.IsNullOrEmpty(FormData.Memo) ? "N/A" : FormData.Memo)" Placeholder="USER DEF" Name="po_contact_person" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </ChildContent>
            </RadzenFieldset>
            <RadzenFieldset AllowCollapse Text="Details">
                <ChildContent>
                    <RadzenRow>
                        <RadzenColumn>
                            <AppTable @ref="@PurchaseOrderTable"
                                      Id="purchase_order_cvu_items"
                                      TItem="PurchaseOrderLineVM"
                                      @bind-GridSettingsLoaded="@GridSettingsLoaded"
                                      Data="@FormData.DocumentLines">
                                <HeaderTemplate>
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 JustifyContent="JustifyContent.End"
                                                 AlignItems="AlignItems.Center"
                                                 Gap="8px">
                                        <RadzenButton Icon="settings"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Click="@OpenTableSettings" />
                                    </RadzenStack>
                                </HeaderTemplate>
                                <Columns>
                                    <RadzenDataGridColumn TItem="PurchaseOrderLineVM"
                                                          Type="@typeof(int)"
                                                          Width="40px"
                                                          Filterable="false" Sortable="false" Pickable="false"
                                                          TextAlign="TextAlign.Center">
                                        <Template Context="data">
                                            @(FormData.DocumentLines.IndexOf(data) + 1)
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="PurchaseOrderLineVM"
                                                          Property="@nameof(PurchaseOrderLineVM.ItemCode)"
                                                          Type="@typeof(string)"
                                                          Title="Item Code" />
                                    <RadzenDataGridColumn TItem="PurchaseOrderLineVM"
                                                          Property="@nameof(PurchaseOrderLineVM.ItemDescription)"
                                                          Type="@typeof(string)"
                                                          Title="Item Description" />
                                    <RadzenDataGridColumn TItem="PurchaseOrderLineVM"
                                                          Property="@nameof(PurchaseOrderLineVM.Location)"
                                                          Type="@typeof(string)"
                                                          Title="Location"
                                                          Width="150px" />
                                    <RadzenDataGridColumn TItem="PurchaseOrderLineVM"
                                                          Property="@nameof(PurchaseOrderLineVM.UoM)"
                                                          Type="@typeof(string)"
                                                          Title="UoM"
                                                          Width="125px" />
                                    <RadzenDataGridColumn TItem="PurchaseOrderLineVM"
                                                          Property="@nameof(PurchaseOrderLineVM.WeightReceived)"
                                                          Type="@typeof(string)"
                                                          Title="Received Weight"
                                                          Width="125px" />
                                    <RadzenDataGridColumn TItem="PurchaseOrderLineVM"
                                                          Property="@nameof(PurchaseOrderLineVM.WeightTotal)"
                                                          Type="@typeof(string)"
                                                          Title="Total Weight"
                                                          Width="125px" />
                                    <RadzenDataGridColumn TItem="PurchaseOrderLineVM"
                                                          Property="@nameof(PurchaseOrderLineVM.QuantityReceived)"
                                                          Type="@typeof(string)"
                                                          Title="Quantity Received"
                                                          Width="125px" />
                                    <RadzenDataGridColumn TItem="PurchaseOrderLineVM"
                                                          Property="@nameof(PurchaseOrderLineVM.QuantityPlanned)"
                                                          Type="@typeof(string)"
                                                          Title="Quantity Planned"
                                                          Width="125px" />
                                    <RadzenDataGridColumn TItem="PurchaseOrderLineVM"
                                                          Property="@nameof(PurchaseOrderLineVM.QuantityBad)"
                                                          Type="@typeof(string)"
                                                          Title="Bad Quantity"
                                                          Width="125px" />
                                </Columns>
                            </AppTable>
                        </RadzenColumn>
                    </RadzenRow>
                </ChildContent>
            </RadzenFieldset>
            <RadzenRow>
                <RadzenColumn>
                    <RadzenStack class="rz-mt-8" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start">
                        <RadzenButton IsBusy="@IsBusy" Text="Back" Disabled="@(IsBusy || Creating)" ButtonStyle="ButtonStyle.Base" Click="@Return" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenTemplateForm>
</AppContent>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="PurchaseOrderLineVM"
                                    @bind-Grid=@PurchaseOrderTable.DataGrid
                                    @bind-GridSettings=@PurchaseOrderTableSettings />,
        options: GridSettingsService.GetDialogOptions());

        await PurchaseOrderTable.DataGrid.Reload();
    }
}