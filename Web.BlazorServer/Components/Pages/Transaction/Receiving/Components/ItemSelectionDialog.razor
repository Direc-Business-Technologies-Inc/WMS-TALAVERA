@using Web.BlazorServer.ViewModels.Transaction.Receiving

@inherits BaseComponent

<RadzenStack Gap="1rem">
    <RadzenText Text="Multiple items match the scanned ISBN. Please select one to increment its quantity." TextStyle="TextStyle.Body2" />
    <RadzenDataGrid Data="@Items" TItem="PurchaseOrderLineVM" SelectionMode="DataGridSelectionMode.Single" @bind-Value="@SelectedItems">
        <Columns>
            <RadzenDataGridColumn TItem="PurchaseOrderLineVM" Property="@nameof(PurchaseOrderLineVM.ItemCode)" Title="Item Code" />
            <RadzenDataGridColumn TItem="PurchaseOrderLineVM" Property="@nameof(PurchaseOrderLineVM.ItemName)" Title="Item Name" />
            <RadzenDataGridColumn TItem="PurchaseOrderLineVM" Property="@nameof(PurchaseOrderLineVM.OpenQuantity)" Title="Open Qty" TextAlign="TextAlign.Right" />
            <RadzenDataGridColumn TItem="PurchaseOrderLineVM" Property="@nameof(PurchaseOrderLineVM.Quantity)" Title="Received Qty" TextAlign="TextAlign.Right" />
        </Columns>
    </RadzenDataGrid>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="10px">
        <RadzenButton Text="Select" Click="@Select" Disabled="@(SelectedItems == null || !SelectedItems.Any())" ButtonStyle="ButtonStyle.Success" />
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Base" Click="@Cancel" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter] public List<PurchaseOrderLineVM> Items { get; set; } = [];
    IList<PurchaseOrderLineVM> SelectedItems { get; set; }

    void Select() => DialogService.Close(SelectedItems.FirstOrDefault());
    void Cancel() => DialogService.Close(null);
}
