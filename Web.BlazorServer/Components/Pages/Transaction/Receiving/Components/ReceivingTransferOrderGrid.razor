@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Administration.User
@using Web.BlazorServer.ViewModels.Transaction.Receiving

@inherits BaseComponent

<AppDataGrid @ref="@TransferOrderDataGrid" Id="purchase_order_grid" TItem="ReceivingTransferOrderDataGridVM" DataGetter="@LoadDataAsync" GridSettings="@DataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" ActionName="@ActionGetPurchaseOrders">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
            <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
            <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="TransferOrderDataGrid.ReloadDataAsync" />
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        <RadzenDataGridColumn TItem="ReceivingTransferOrderDataGridVM"
                              Property="@nameof(ReceivingTransferOrderDataGridVM.ReferenceNumber)"
                              Type="@typeof(int)"
                              Title="Reference Number" />
        <RadzenDataGridColumn TItem="ReceivingTransferOrderDataGridVM"
                              Property="@nameof(ReceivingTransferOrderDataGridVM.Date)"
                              Type="@typeof(DateTime)"
                              FormatString="{0:yyyy-MM-dd}"
                              Title="Transfer Order Date" />
        <RadzenDataGridColumn TItem="ReceivingTransferOrderDataGridVM"
                              Property="@nameof(ReceivingTransferOrderDataGridVM.DeliveryDate)"
                              Type="@typeof(DateTime)"
                              FormatString="{0:yyyy-MM-dd}"
                              Title="Delivery Date" />
        <RadzenDataGridColumn TItem="ReceivingTransferOrderDataGridVM"
                              Property="@nameof(ReceivingTransferOrderDataGridVM.RequestorName)"
                              Type="@typeof(string)"
                              Title="Requestor" />
        <RadzenDataGridColumn TItem="ReceivingTransferOrderDataGridVM"
                              Property="@nameof(ReceivingTransferOrderDataGridVM.SourceLocation)"
                              Type="@typeof(string)"
                              Title="Source Location" />
        <RadzenDataGridColumn TItem="ReceivingTransferOrderDataGridVM"
                              Property="@nameof(ReceivingTransferOrderDataGridVM.TransferLocation)"
                              Type="@typeof(string)"
                              Title="Transfer Location" />
        <RadzenDataGridColumn TItem="ReceivingTransferOrderDataGridVM"
                              Frozen
                              FrozenPosition="FrozenColumnPosition.Right"
                              Width="35px">
            <Template>
                <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Click="() => ViewTransferOrder(context)" />
            </Template>
        </RadzenDataGridColumn>
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="ReceivingTransferOrderDataGridVM"
                                    @bind-Grid=@TransferOrderDataGrid.DataGrid
                                    @bind-GridSettings=@DataGridSettings />,
        options: GridSettingsService.GetDialogOptions());

        await TransferOrderDataGrid.DataGrid.Reload();
    }
}