@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.Components.Pages.Transaction.Others
@using Web.BlazorServer.Services.Repositories
@using Web.BlazorServer.ViewModels.Others
@using Web.BlazorServer.ViewModels.Transaction.Receiving

@inherits BaseComponent
@inject IGridSettingsService GridSettingsService

<RadzenTemplateForm TItem="ItemReceiptVM" EditContext="@EditContext" Submit="@Submit">
    <RadzenStack Gap="0.5em">
        <RadzenFieldset Text="Details" AllowCollapse>
            <RadzenRow Gap="0.5em">
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Created From" class="rz-w-100">
                        <RadzenTextBox Disabled="Disabled" Value="@Data.CreatedFrom" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Date" class="rz-w-100">
                        <RadzenDatePicker Disabled="Disabled" DateFormat="MMMM dd, yyyy" @bind-Value="@Data.Date" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                @if (Data.SourceType == ItemReceiptVM.SourceTypes.TransferOrder)
                {
                    <RadzenColumn SizeMD="6">
                        <RadzenFormField AllowFloatingLabel="false" Text="From Subsidiary" class="rz-w-100">
                            <RadzenTextBox Disabled="Disabled" Value="@Data.Subsidiary" ReadOnly />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn SizeMD="6">
                        <RadzenFormField AllowFloatingLabel="false" Text="To Subsidiary" class="rz-w-100">
                            <RadzenTextBox Disabled="Disabled" Value="@Data.ToSubsidiary" ReadOnly />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn SizeMD="6">
                        <RadzenFormField AllowFloatingLabel="false" Text="From Warehouse" class="rz-w-100">
                            <RadzenTextBox Disabled="Disabled" Value="@Data.Location?.Name" ReadOnly />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn SizeMD="6">
                        <RadzenFormField AllowFloatingLabel="false" Text="To Warehouse" class="rz-w-100">
                            <RadzenTextBox Disabled="Disabled" Value="@Data.TransferLocation" ReadOnly />
                        </RadzenFormField>
                    </RadzenColumn>
                }
                else if (Data.SourceType == ItemReceiptVM.SourceTypes.Returns)
                {
                    <RadzenColumn SizeMD="4">
                        <RadzenFormField AllowFloatingLabel="false" Text="Subsidiary" class="rz-w-100">
                            <RadzenTextBox Disabled="Disabled" Value="@Data.Subsidiary" ReadOnly />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn SizeMD="4">
                        <RadzenFormField AllowFloatingLabel="false" Text="From Warehouse" class="rz-w-100">
                            <RadzenTextBox Disabled="Disabled" Value="@Data.Location?.Name" ReadOnly />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn SizeMD="4">
                        <RadzenFormField AllowFloatingLabel="false" Text="To Warehouse" class="rz-w-100">
                            <RadzenTextBox Disabled="Disabled" Value="@Data.TransferLocation" ReadOnly />
                        </RadzenFormField>
                    </RadzenColumn>
                }
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Department" class="rz-w-100">
                        <RadzenTextBox Disabled="Disabled" Value="@Data.Department" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenFormField AllowFloatingLabel="false" Text="Vendor" class="rz-w-100">
                        <RadzenTextBox Disabled="Disabled" ReadOnly Value="@Data.Vendor" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenFieldset AllowCollapse Text="Lines">
            <AppTableWithSettings Data="@Data.Lines" Id="item_receipt_lines">
                <HeaderTemplate>
                    <RadzenButton Disabled="Disabled" Text="Scan Barcodes" Icon="barcode" Click="OpenBarcodeDialog" ButtonType="ButtonType.Button" Size="ButtonSize.Small" />
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="ItemReceiptLineVM" Width="30px">
                        <Template Context="data">
                            <RadzenCheckBox @bind-Value="data.IsReceived" Disabled="@(data.IsComplete || Disabled)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ItemReceiptLineVM" Property="@nameof(ItemReceiptLineVM.ItemCode)" Title="Item Code" />
                    <RadzenDataGridColumn TItem="ItemReceiptLineVM" Property="@nameof(ItemReceiptLineVM.ItemDescription)" Title="Item Description" />
                    <RadzenDataGridColumn TItem="ItemReceiptLineVM" Property="@nameof(ItemReceiptLineVM.UoM)" Title="UoM" />
                    <RadzenDataGridColumn TItem="ItemReceiptLineVM" Property="@nameof(ItemReceiptLineVM.Department)" Title="Department" />
                    <RadzenDataGridColumn TItem="ItemReceiptLineVM" Property="@nameof(ItemReceiptLineVM.LocationName)" Title="Warehouse" />
                    <RadzenDataGridColumn TItem="ItemReceiptLineVM" Property="@nameof(ItemReceiptLineVM.WeightActual)" Title="Actual Weight" >
                        <Template Context="data">
                            <RadzenNumeric Min="0" @bind-Value="data.WeightActual" ShowUpDown="false" Disabled="@(!data.IsReceived || Disabled)"/>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ItemReceiptLineVM" Property="@nameof(ItemReceiptLineVM.WeightRecord)" Title="Record Weight" />
                    <RadzenDataGridColumn TItem="ItemReceiptLineVM" Property="@nameof(ItemReceiptLineVM.QuantityPlanned)" Title="Planned Quantity" />
                    <RadzenDataGridColumn TItem="ItemReceiptLineVM" Property="@nameof(ItemReceiptLineVM.QuantityReceived)" Title="Received Quantity" />
                    <RadzenDataGridColumn TItem="ItemReceiptLineVM" Property="@nameof(ItemReceiptLineVM.QuantityAlloted)" Title="Quantity" >
                        <Template Context="data">
                            <RadzenStack>
                                <RadzenFormField Text="Quantity">
                                    <ChildContent>
                                        <RadzenNumeric Name="line_quantity_good" @bind-Value="@data.QuantityAlloted" Disabled="@(!data.IsReceived || Disabled || Data.Location is null)" Max="@(data.QuantityOpen)" Min="0"/>
                                    </ChildContent>
                                    <End>
                                        <RadzenButton Icon="@(data.IsAllAssigned ? "assignment_turned_in" : "assignment_returned")"
                                                      MouseEnter="@(args => ShowLineTooltip(args, data))"
                                                      ButtonStyle="@(data.IsAllAssigned ? ButtonStyle.Success : ButtonStyle.Warning)"
                                                      Size="ButtonSize.ExtraSmall"
                                                      Disabled="Disabled"
                                                      Click="_ => OpenInventoryDetailDialog(data)" />
                                    </End>
                                </RadzenFormField>
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </AppTableWithSettings>
        </RadzenFieldset>
        <RadzenFieldset Text="Additional Details">
            <RadzenRow>
                <RadzenColumn SizeMD="4" OffsetMD="8">
                    <RadzenFormField Text="Received by" class="rz-w-100">
                        <RadzenTextBox Value="@Data.ReceivedBy" ReadOnly />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Orientation="Orientation.Horizontal">
            <RadzenButton Disabled="Disabled" ButtonStyle="ButtonStyle.Light" ButtonType="ButtonType.Button" Click="@Return" Text="Return" />
            <RadzenButton Disabled="Disabled" ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit" Text="Submit" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>


@code {
    async Task OpenBarcodeDialog()
    {
        bool? save = await DialogService.OpenAsync(
            "Table Settings",
            ds => @<ScanDialog OnBarcodeAdded="BarcodeScanned" Barcodes="Barcodes" />,
            options: GridSettingsService.GetDialogOptions());
        
        if (save == false) ClearAddedBarcodes();
        else if (save == true) Barcodes.Clear();
    }

    
    async Task OpenInventoryDetailDialog(ItemReceiptLineVM line)
    {
        if (line.QuantityAlloted <= 0)
        {
            ToastService.Error("Please assign alloted quantity");
            return;
        }

        DialogOptions opts = new()
        {
            CloseDialogOnOverlayClick = true,
            CloseDialogOnEsc = true,
            Draggable = true,
            Resizable = true,
            Width = "80%",
            ShowClose = true
        };

        InventoryDetailsDialog.Types Type = InventoryDetailsDialog.Types.Incoming;

        List<InventoryDetailVM> items = await DialogService.OpenAsync(
            "Set Inventory Details",
            ds => @<InventoryDetailsDialog LocationId="@line.LocationId" StatusFilters="StatusFilters" Amount="@line.QuantityAlloted" Type="Type" ItemId="@line.ItemId" InventoryDetails="@line.InventoryDetails"/>,
    options: opts);

        
        if (items is not null)
        {
            await SetLineInventoryDetails(line, items);
        }
    }
}