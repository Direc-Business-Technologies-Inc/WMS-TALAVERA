@using Domain.Entities.Enums.Transaction.InventoryCounting
@using Web.BlazorServer.Components.Pages.Transaction.InventoryCounting.Components
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.Extensions
@using Web.BlazorServer.ViewModels.Others
@using Web.BlazorServer.ViewModels.Transaction.InventoryCounting

@inherits BaseForm<InventoryCountingVM>
@page "/transactions/inventory/inventory-counting/create"
@page "/transactions/inventory/inventory-counting/view"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OICT")]

<PageTitle>@(Creating ? "New Inventory Counting" : $"Inventory Counting {FormData.AppDocNum.Value}")</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OICT" />
        <RadzenStack Visible="@Viewing" Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="View Sheets" Icon="list"
                          ButtonStyle="ButtonStyle.Info"
                          Visible="@(FormData.Sheets.Any())"
                          Click="@OpenSheetsModal" />
            <RadzenButton Text="Add Sheet" Icon="add"
                          ButtonStyle="ButtonStyle.Success"
                          Visible="@(FormData.Status is InventoryCountingDocumentStatus.Open or InventoryCountingDocumentStatus.Recount)"
                          Click="@AddSheet" />
        </RadzenStack>
</RadzenStack>

<AppContent>
    <AppFormSkeleton TItem="InventoryCountingVM" Loading="@IsLoadingData" />

    @* Header badges — view mode only *@
    <RadzenStack Visible="@(Viewing && !IsLoadingData)"
                 Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.End" Gap="1rem" class="rz-mb-2">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            <AppContentBadge Title="Doc #" Content="@FormData.AppDocNum.Value" />
            <AppContentBadge Title="Status" Content="@FormData.Status.ToString()"
                             ChildBadgeStyle="@(FormData.Status switch {
                                 InventoryCountingDocumentStatus.Open => BadgeStyle.Success,
                                 InventoryCountingDocumentStatus.Recount => BadgeStyle.Warning,
                                 InventoryCountingDocumentStatus.Saved => BadgeStyle.Info,
                                 InventoryCountingDocumentStatus.Posted => BadgeStyle.Secondary,
                                 _ => BadgeStyle.Light
                             })" />
        </RadzenStack>
    </RadzenStack>

    <RadzenTemplateForm Visible="@(!IsLoadingData)" @ref="@TemplateForm"
                        TItem="InventoryCountingVM" @bind-Data="@FormData"
                        EditContext="@EditContext" Submit="@HandleSubmit">
        <RadzenStack Gap="1rem">

            <RadzenFieldset AllowCollapse Text="Details">
                <ChildContent>
                    <RadzenStack Gap="0.5rem">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Warehouse" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox Visible="@Viewing" ReadOnly
                                                       Value="@FormData.Warehouse.WhsName"
                                                       Placeholder="No Warehouse Selected"
                                                       class="rz-w-100" />
                                        <RadzenDropDown Visible="@Creating"
                                                        @bind-Value="@FormData.Warehouse"
                                                        Change="() => OnWarehouseChange()"
                                                        Data="@Warehouses"
                                                        Count="@WarehousesCount"
                                                        LoadData="@LoadWarehouses"
                                                        AllowVirtualization
                                                        AllowClear
                                                        AllowFiltering
                                                        Name="ict_whs"
                                                        TextProperty="@nameof(WarehouseVM.WhsName)"
                                                        Placeholder="Select Warehouse"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenCustomValidator Visible="@Creating" Component="ict_whs" Popup
                                                               Validator="() => !string.IsNullOrEmpty(FormData.Warehouse?.WhsCode)"
                                                               Text="Warehouse is required" />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Counting Date" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox Visible="@Viewing" ReadOnly
                                                       Value="@FormData.CountingDate.ToString("MM/dd/yyyy")"
                                                       class="rz-w-100" />
                                        <RadzenDatePicker Visible="@Creating"
                                                          @bind-Value="@FormData.CountingDate"
                                                          Name="ict_date"
                                                          DateFormat="MM/dd/yyyy"
                                                          class="rz-w-100" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenCustomValidator Visible="@Creating" Component="ict_date" Popup
                                                               Validator="() => FormData.CountingDate != default"
                                                               Text="Counting Date is required" />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Cycle Type" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox Visible="@Viewing" ReadOnly
                                                       Value="@FormData.CycleType.ToString()"
                                                       class="rz-w-100" />
                                        <RadzenDropDown Visible="@Creating"
                                                        @bind-Value="@FormData.CycleType"
                                                        Data="@CycleTypeValues"
                                                        Name="ict_cycle"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12">
                                <RadzenFormField Text="Remarks" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextArea ReadOnly="@Viewing"
                                                        @bind-Value="@FormData.Remarks"
                                                        Name="ict_remarks" Rows="2"
                                                        Placeholder="Optional remarks..."
                                                        class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </ChildContent>
            </RadzenFieldset>

            <RadzenFieldset AllowCollapse Text="Document Lines">
                <ChildContent>
                    <RadzenRow>
                        <RadzenColumn>
                            @* Creating: client-side table *@
                            <AppTable Visible="@Creating"
                                      @ref="@DocumentLinesTable"
                                      ActionName="ActionGetItems"
                                      Id="ict_lines_create"
                                      TItem="InventoryCountingLineVM"
                                      @bind-GridSettingsLoaded="@GridSettingsLoaded"
                                      Data="[..FormData.DocumentLines]">
                                <HeaderTemplate>
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                                        <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenLinesTableSettings" />
                                        <RadzenButton Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success"
                                                      Disabled="@(string.IsNullOrEmpty(FormData.Warehouse?.WhsCode) || IsLoadingWarehouseItems)"
                                                      Click="@AddItems" />
                                    </RadzenStack>
                                </HeaderTemplate>
                                <Columns>
                                    <RadzenDataGridColumn TItem="InventoryCountingLineVM"
                                                          Property="@nameof(InventoryCountingLineVM.ItemCode)"
                                                          Title="Item Code" Type="@typeof(string)" />
                                    <RadzenDataGridColumn TItem="InventoryCountingLineVM"
                                                          Property="@nameof(InventoryCountingLineVM.ItemName)"
                                                          Title="Item Name" Type="@typeof(string)" />
                                    <RadzenDataGridColumn TItem="InventoryCountingLineVM"
                                                          Property="@nameof(InventoryCountingLineVM.UoMName)"
                                                          Title="UoM" Width="100px" Type="@typeof(string)" />
                                    <RadzenDataGridColumn TItem="InventoryCountingLineVM"
                                                          Property="@nameof(InventoryCountingLineVM.Quantity)"
                                                          Title="On Hand" Width="120px" Type="@typeof(decimal)">
                                        <Template Context="lineVm">
                                            @lineVm.Quantity.ToString("N0")
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="InventoryCountingLineVM"
                                                          Frozen FrozenPosition="FrozenColumnPosition.Right"
                                                          Width="45px" MaxWidth="45px"
                                                          Pickable="false" Sortable="false" Filterable="false">
                                        <Template Context="lineVm">
                                            <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall"
                                                          ButtonStyle="ButtonStyle.Danger"
                                                          Click="() => RemoveLine(lineVm)" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </AppTable>

                            @* Viewing: grid with sub-row expansion *@
                            <RadzenDataGrid Visible="@Viewing"
                                            TItem="InventoryCountingLineVM"
                                            Data="@FormData.DocumentLines"
                                            AllowPaging ShowPagingSummary
                                            RowRender="@ExpandAllRows">
                                <Template Context="line">
                                    @* Sub-rows: sheet contributions for this line *@
                                    @{
                                        var contributions = FormData.Sheets
                                            .SelectMany(s => s.SheetLines
                                                .Where(sl => sl.ItemCode == line.ItemCode)
                                                .Select(sl => new { s.SheetNo.Value, s.Counter.Name, s.SubmittedDate, sl.Quantity }))
                                            .ToList();
                                    }
                                    <RadzenDataGrid TItem="@(dynamic)" Data="@contributions"
                                                    AllowPaging="false" ShowPagingSummary="false">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="@(dynamic)" Title="Sheet No">
                                                <Template Context="row">@row.Value</Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="@(dynamic)" Title="Counter">
                                                <Template Context="row">@row.Name</Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="@(dynamic)" Title="Submitted Date">
                                                <Template Context="row">@(((DateTime)row.SubmittedDate).ToString("MM/dd/yyyy"))</Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="@(dynamic)" Title="Count Qty">
                                                <Template Context="row">@(((decimal)row.Quantity).ToString("N0"))</Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                </Template>
                                <Columns>
                                    <RadzenDataGridColumn TItem="InventoryCountingLineVM"
                                                          Property="@nameof(InventoryCountingLineVM.ItemCode)"
                                                          Title="Item Code" Type="@typeof(string)" />
                                    <RadzenDataGridColumn TItem="InventoryCountingLineVM"
                                                          Property="@nameof(InventoryCountingLineVM.ItemName)"
                                                          Title="Item Name" Type="@typeof(string)" />
                                    <RadzenDataGridColumn TItem="InventoryCountingLineVM"
                                                          Property="@nameof(InventoryCountingLineVM.UoMName)"
                                                          Title="UoM" Width="100px" Type="@typeof(string)" />
                                    <RadzenDataGridColumn TItem="InventoryCountingLineVM"
                                                          Property="@nameof(InventoryCountingLineVM.Quantity)"
                                                          Title="On Hand" Width="120px">
                                        <Template Context="lineVm">
                                            @lineVm.Quantity.ToString("N0")
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="InventoryCountingLineVM"
                                                          Property="@nameof(InventoryCountingLineVM.ActualQuantity)"
                                                          Title="Actual Qty" Width="120px">
                                        <Template Context="lineVm">
                                            @lineVm.ActualQuantity.ToString("N0")
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>

                        </RadzenColumn>
                    </RadzenRow>
                </ChildContent>
            </RadzenFieldset>

            <RadzenRow>
                <RadzenColumn>
                    <RadzenStack class="rz-mt-4" Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenButton Text="Back" ButtonStyle="ButtonStyle.Base" Click="@GoBack" />
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="8px" AlignItems="AlignItems.Center">
                            @* Creating *@
                            <RadzenButton Visible="@Creating" ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit">
                                Submit
                            </RadzenButton>
                            @* Viewing — editable statuses only *@
                            <RadzenButton Visible="@(Viewing && IsEditableStatus)"
                                          Text="Save" ButtonStyle="ButtonStyle.Info"
                                          IsBusy="@AppBusyService.IsBusy(ActionSave)"
                                          Click="@SaveDocument" />
                            <RadzenButton Visible="@(Viewing && IsEditableStatus)"
                                          Text="Post" ButtonStyle="ButtonStyle.Success"
                                          IsBusy="@AppBusyService.IsBusy(ActionPost)"
                                          Click="@PostDocument" />
                            <RadzenButton Visible="@(Viewing && IsEditableStatus)"
                                          Text="Recount" ButtonStyle="ButtonStyle.Warning"
                                          IsBusy="@AppBusyService.IsBusy(ActionRecount)"
                                          Click="@RecountDocument" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

        </RadzenStack>
    </RadzenTemplateForm>

</AppContent>

@code {
    async Task AddItems()
    {
        await DialogService.OpenAsync(
            "Item Selection",
            ds => @<InventoryCountingItemSelection @bind-Document="@FormData" />,
            options: GridSettingsService.GetDialogOptions().MaximizedMode());
        await DocumentLinesTable.DataGrid.Reload();
    }

    async Task OpenLinesTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="InventoryCountingLineVM"
                                    @bind-Grid=@DocumentLinesTable.DataGrid
                                    @bind-GridSettings=@DocumentLinesTableSettings />,
            options: GridSettingsService.GetDialogOptions());
        await DocumentLinesTable.DataGrid.Reload();
    }

    async Task OpenSheetsModal()
    {
        await DialogService.OpenAsync(
            "Sheets",
            ds => @<InventoryCountingSheetListModal Sheets="@FormData.Sheets" DocumentId="@FormData.Id" />,
            options: GridSettingsService.GetDialogOptions().MaximizedMode());
    }
}
