@using global::Shared.Entities
@using global::Shared.Libraries.ViewModel.InventoryCounting

@inherits BaseComponent

<AppDataGrid @ref="@DataGrid"
             Id="inventory_counting_open_grid"
             TItem="InventoryCountingVM"
             DataGetter="@LoadDataAsync"
             GridSettings="@GridSettings"
             @bind-GridSettingsLoaded="@GridSettingsLoaded"
             ActionName="@ActionGetAll">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
            <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
            <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="DataGrid.ReloadDataAsync" />
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        <RadzenDataGridColumn TItem="InventoryCountingVM"
                              Property="@nameof(InventoryCountingVM.NetsuiteOrderInternalId)"
                              Title="NetSuite ID"
                              Width="120px"
                              Type="@typeof(int)" />
        <RadzenDataGridColumn TItem="InventoryCountingVM"
                              Property="@nameof(InventoryCountingVM.OrderNumber)"
                              Title="Document"
                              Type="@typeof(string)" />
        <RadzenDataGridColumn TItem="InventoryCountingVM"
                              Property="@nameof(InventoryCountingVM.OrderStatus)"
                              Title="Status">
            <Template>
                <AppContentBadge Title="" Content="@context.GetName(context.OrderStatus)" ChildBadgeStyle="BadgeStyle.Success" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InventoryCountingVM"
                              Property="@nameof(InventoryCountingVM.OrderType)"
                              Title="Order Type"
                              Type="@typeof(string)" />
        <RadzenDataGridColumn TItem="InventoryCountingVM"
                              Property="@nameof(InventoryCountingVM.NetsuiteOrderCreatedDate)"
                              Title="Created Date"
                              Type="@typeof(DateTime)">
            <Template>
                @context.NetsuiteOrderCreatedDate.ToString("MM/dd/yyyy")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InventoryCountingVM"
                              Frozen FrozenPosition="FrozenColumnPosition.Right"
                              Width="35px" Filterable="false" Sortable="false" Pickable="false">
            <Template>
                <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Click="() => ViewDocument(context)" />
            </Template>
        </RadzenDataGridColumn>
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="InventoryCountingVM"
                                    @bind-Grid=@DataGrid.DataGrid
                                    @bind-GridSettings=@GridSettings />,
            options: GridSettingsService.GetDialogOptions());
        await DataGrid.DataGrid.Reload();
    }
}
