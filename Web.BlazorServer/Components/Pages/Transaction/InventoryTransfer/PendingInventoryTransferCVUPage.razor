@using Web.BlazorServer.Components.Pages.Transaction.InventoryTransfer.Components
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.ViewModels.Others
@using Web.BlazorServer.ViewModels.Transaction.InventoryTransfer

@layout ProtectedLayout
@inherits BaseComponent
@page "/transactions/inventory/inventory-transfer/pending-inventory-transfer-request/view"
@attribute [AppAuthorizationAttribute("VIEW", "OITR")]

<PageTitle>Pending ITR : @Ref</PageTitle>

<ReadOnlyForm ActionName="@ActionGetPendingInventoryTransferRequest"
              DataGetter="@GetPendingInventoryTransferRequest"
              AdditionalRoutes="@AdditionalRoutes"
              ParentURI="/transactions/inventory/inventory-transfer?T=pending">
         
    <ContentBadges>
        <AppContentBadge Title="Status" Content="Pending" ChildBadgeStyle="BadgeStyle.Secondary" />
    </ContentBadges>
</ReadOnlyForm>
