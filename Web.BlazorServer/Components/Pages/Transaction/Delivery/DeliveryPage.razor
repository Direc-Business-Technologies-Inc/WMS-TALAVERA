@using Web.BlazorServer.Components.Pages.Transaction.Delivery.Components
@using Web.BlazorServer.Components.Security

@inherits BaseComponent
@page "/transactions/sales/delivery"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "ODLV")]

<PageTitle>Delivery</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="ODLV" />
</RadzenStack>

<AppContent>
    <RadzenTabs @bind-SelectedIndex="@SelectedTab" @bind-SelectedIndex:after="@TabChanged">
        <Tabs>
            <RadzenTabsItem Text="Sales Orders">
                <SalesOrderDataGrid />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Deliveries">
                <DeliveryDataGrid />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</AppContent>
