@using Web.BlazorServer.Components.Pages.Transaction.GoodsReturn.Components
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.Components.Shared.Skeletons
@using Web.BlazorServer.Extensions
@using Web.BlazorServer.ViewModels.Others
@using Web.BlazorServer.ViewModels.Transaction.GoodsReturn

@inherits BaseForm<GoodsReturnVM>
@page "/transactions/purchasing/goods-return/create"
@page "/transactions/purchasing/goods-return/view"
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OGRN")]

<PageTitle>@(Creating ? "New Goods Return Document" : string.Empty)@(Viewing ? $"Goods Return {FormData.SapReference.DocNum}" : string.Empty)</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OGRN" />
</RadzenStack>

<AppContent>

    <AppFormSkeleton TItem="GoodsReturnVM" Loading="@IsLoadingData" />

    <RadzenStack Visible="@(!IsLoadingData)" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="32px" class="rz-mb-2">
        <AppContentBadge Visible="@Viewing" Title="Doc" Content="@FormData.SapReference.DocNum.ToString()" />
        <AppContentBadge Title="Doc Date" Content="@FormData.DocDate.ToString("MM-dd-yy")" ChildBadgeStyle="BadgeStyle.Secondary" ChildShade="Shade.Default" />
        <AppContentBadge Title="Doc Due Date" Content="@FormData.DocDueDate.ToString("MM-dd-yy")" ChildBadgeStyle="BadgeStyle.Secondary" ChildShade="Shade.Default" />
    </RadzenStack>

    <RadzenTemplateForm Visible="@(!IsLoadingData)" @ref="@TemplateForm" TItem="GoodsReturnVM" @bind-Data="@FormData" EditContext="@EditContext" Submit="@HandleSubmit">
        <RadzenStack Gap="1rem">

            <RadzenFieldset AllowCollapse Text="Details">
                <ChildContent>
                    <RadzenStack Gap="0.5rem">

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Vendor Ref No." class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Visible="@Viewing" Value="@FormData.BusinessPartner.CardName" Name="gr_card_name" Disabled="@IsBusy" class="rz-w-100" />
                                        <RadzenDropDown Visible="@(Creating)"
                                                        @bind-Value="@FormData.BusinessPartner"
                                                        Change="(args) => OnFieldChanged(nameof(FormData.BusinessPartner))"
                                                        Data="@BusinessPartners"
                                                        Count="@BusinessPartnersCount"
                                                        LoadData="@LoadVendors"
                                                        AllowVirtualization
                                                        Name="gr_bp"
                                                        AllowFiltering
                                                        TextProperty="@nameof(BusinessPartnerVM.CardName)"
                                                        Placeholder="No Vendor Selected"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                    <End>
                                        <RadzenButton Visible="@(!FormData.ValidateBusinessPartner())" Size="ButtonSize.ExtraSmall" Text="Copy From GRPO" Click="@CopyFrom" />
                                    </End>
                                    <Helper>
                                        <RadzenCustomValidator Visible="@(Creating)" Component="gr_bp" Popup Validator="@FormData.ValidateBusinessPartner" Text="Vendor is required" />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Return Type" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Visible="@Viewing" Value="@FormData.ReturnType" Name="gr_return_type" Placeholder="No Return Type Selected" Disabled="@IsBusy" class="rz-w-100" />
                                        <RadzenDropDown Visible="@(Creating)"
                                                        @bind-Value="@FormData.ReturnType"
                                                        Data="@ReturnTypes"
                                                        Name="gr_ret_typ"
                                                        AllowFiltering
                                                        TextProperty="@nameof(ReturnTypeVM.Name)"
                                                        ValueProperty="@nameof(ReturnTypeVM.Code)"
                                                        Placeholder="No Return Type Selected"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenCustomValidator Visible="@(Creating)" Component="gr_ret_typ" Popup Validator="@(() => !string.IsNullOrEmpty(FormData.ReturnType))" Text="Return Type is required" />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="School Year" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox Visible="@(Viewing)" ReadOnly Value="@FormData.SchoolYear" Name="gr_school_year" Placeholder="No School Year Selected" Disabled="@IsBusy" class="rz-w-100" />
                                        <RadzenDropDown Visible="@(!Viewing)"
                                                        @bind-Value="@FormData.SchoolYear"
                                                        Data="@SchoolYears"
                                                        Count="@SchoolYearsCount"
                                                        LoadData="@LoadSchoolYears"
                                                        ValueProperty="@nameof(SchoolYearVM.Code)"
                                                        TextProperty="@nameof(SchoolYearVM.Name)"
                                                        AllowVirtualization
                                                        AllowClear
                                                        Name="gr_sy"
                                                        AllowFiltering
                                                        Placeholder="No School Year Selected"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="Warehouse" class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly Visible="@Viewing" Value="@FormData.Warehouse?.WhsName" Name="gr_whs_name" Placeholder="No Warehouse Selected" Disabled="@IsBusy" class="rz-w-100" />
                                        <RadzenDropDown Visible="@(Creating)"
                                                        @bind-Value="@FormData.Warehouse"
                                                        Change="(args) => OnFieldChanged(nameof(FormData.Warehouse))"
                                                        Data="@Warehouses"
                                                        Count="@WarehousesCount"
                                                        LoadData="@LoadWarehouses"
                                                        AllowVirtualization
                                                        Name="gr_whs"
                                                        AllowFiltering
                                                        TextProperty="@nameof(WarehouseVM.WhsName)"
                                                        Placeholder="No Warehouse Selected"
                                                        class="rz-w-100" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenCustomValidator Visible="@(Creating)" Component="gr_whs" Popup Validator="@FormData.ValidateWarehouse" Text="Source Warehouse is required" />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="DR No." class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.DRNo" Placeholder="DR-015" Name="gr_dr_no" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="SI No." class="rz-w-100" AllowFloatingLabel="false">
                                    <ChildContent>
                                        <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.SINo" Placeholder="SI-06" Name="gr_si_no" Disabled="@IsBusy" class="rz-w-100" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                    </RadzenStack>
                </ChildContent>
            </RadzenFieldset>

            <RadzenFieldset AllowCollapse Text="Details">
                <ChildContent>
                    <RadzenRow>
                        <RadzenColumn>
                            <AppTable @ref="@GoodsReturnTable"
                                      Id="goods_return_cvu_items"
                                      TItem="GoodsReturnLineVM"
                                      @bind-GridSettingsLoaded="@GridSettingsLoaded"
                                      Data="@FormData.DocumentLines">
                                <HeaderTemplate>
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 JustifyContent="JustifyContent.End"
                                                 AlignItems="AlignItems.Center"
                                                 Gap="8px">
                                        <RadzenButton Icon="settings"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Click="@OpenTableSettings" />
                                    </RadzenStack>
                                </HeaderTemplate>
                                <HeaderTemplate>
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                                        <RadzenButton Visible="@Creating" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@AddItems" Disabled="@(string.IsNullOrEmpty(FormData.Warehouse?.WhsCode))" />
                                    </RadzenStack>
                                </HeaderTemplate>
                                <Columns>
                                    <RadzenDataGridColumn TItem="GoodsReturnLineVM"
                                                          Width="40px" TextAlign="TextAlign.Center">
                                        <Template Context="data">
                                            @(FormData.DocumentLines.IndexOf(data) + 1)
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GoodsReturnLineVM"
                                                          Property="@nameof(GoodsReturnLineVM.ItemCode)"
                                                          Type="@typeof(string)"
                                                          Title="Item Code" />
                                    <RadzenDataGridColumn TItem="GoodsReturnLineVM"
                                                          Property="@nameof(GoodsReturnLineVM.ItemName)"
                                                          Type="@typeof(string)"
                                                          Title="Item Name" />
                                    <RadzenDataGridColumn TItem="GoodsReturnLineVM"
                                                          Property="@nameof(GoodsReturnLineVM.Warehouse.WhsName)"
                                                          Type="@typeof(string)"
                                                          Title="Warehouse" Width="150px">
                                        <Template Context="data">
                                            @data.Warehouse.WhsName
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GoodsReturnLineVM"
                                                          Property="@nameof(GoodsReturnLineVM.UoMName)"
                                                          Type="@typeof(string)"
                                                          Title="UoM" Width="125px" />
                                    <RadzenDataGridColumn Visible="@(Creating && !FormData.Standalone)" TItem="GoodsReturnLineVM"
                                                          Property="@nameof(GoodsReturnLineVM.OpenQuantity)"
                                                          Type="@typeof(decimal)"
                                                          Title="Open Quantity" Width="150px">
                                        <Template Context="data">
                                            <RadzenNumeric Format="N0" @bind-Value="@data.OpenQuantity" Min="0" ReadOnly ShowUpDown="false" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GoodsReturnLineVM"
                                                          Property="@nameof(GoodsReturnLineVM.Quantity)"
                                                          Type="@typeof(decimal)"
                                                          Title="Quantity" Width="150px">
                                        <Template Context="data">
                                            <RadzenNumeric Format="N0" @bind-Value="@data.Quantity" Min="0" Max="@(FormData.Standalone ? null : data.OpenQuantity)" ReadOnly="@(Viewing || (!FormData.Standalone && data.OpenQuantity <= 0))" ShowUpDown="@Creating" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GoodsReturnLineVM"
                                                          Type="@typeof(bool)"
                                                          Frozen
                                                          FrozenPosition="FrozenColumnPosition.Right"
                                                          Width="45px"
                                                          MaxWidth="45px"
                                                          Pickable="false" Sortable="false" Filterable="false"
                                                          Visible="@Creating">
                                        <Template Context="data">
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceEvenly">
                                                <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger" Click="() => RemoveLine(data)" />
                                            </RadzenStack>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </AppTable>
                        </RadzenColumn>
                    </RadzenRow>

                </ChildContent>
            </RadzenFieldset>
            
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Remarks" class="rz-w-100" AllowFloatingLabel="false">
                        <ChildContent>
                            <RadzenTextArea ReadOnly="@Viewing" @bind-Value="@FormData.DocRemarks" Name="gr_remarks" Rows="3" Disabled="@IsBusy" class="rz-w-100" Placeholder="This Purchase Return is for ..." />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4" OffsetMD="4">
                    <RadzenStack Gap="0.5rem">
                        <RadzenFormField Text="Prepared By" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly Value="@FormData.PreparedBy" Name="gr_prep_by" Placeholder="WMS User ABC" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="Reviewed By" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.ReviewedBy" Name="gr_rev_by" Placeholder="WMS User C" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="Checked By" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.CheckedBy" Name="gr_chkd_by" Placeholder="WMS User A" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                        <RadzenFormField Text="ApprovedBy" class="rz-w-100" AllowFloatingLabel="false">
                            <ChildContent>
                                <RadzenTextBox ReadOnly="@Viewing" @bind-Value="@FormData.ApprovedBy" Name="gr_app_by" Placeholder="WMS User B" Disabled="@IsBusy" class="rz-w-100" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn>
                    <RadzenStack class="rz-mt-8" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenButton IsBusy="@IsBusy" Text="Back" Disabled="@(IsBusy && Creating)" ButtonStyle="ButtonStyle.Base" Click="@Return" />
                        <RadzenStack Visible="@(Can.Create("OGRN") && Creating)" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="16px">
                            <RadzenButton IsBusy="@IsBusy" Visible="@(Creating)" ButtonStyle="ButtonStyle.Success" ButtonType="ButtonType.Submit">
                                Save
                            </RadzenButton>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

        </RadzenStack>
    </RadzenTemplateForm>

</AppContent>

@code {
    async Task AddItems()
    {
        await DialogService.OpenAsync(
            "Item Selection",
            ds => @<GoodsReturnItemSelection @bind-Return="@FormData" />,
    options: GridSettingsService.GetDialogOptions().MaximizedMode());

        await GoodsReturnTable.DataGrid.Reload();
    }

    async Task CopyFrom()
    {
        bool? result = await DialogService.OpenAsync(
            "GRPO Selection",
            ds => @<GoodsReturnGRPOSelection @bind-Document="@FormData" />,
    options: GridSettingsService.GetDialogOptions().MaximizedMode());

        if (result is not null && result is true)
            FormData.Standalone = false;
        await GoodsReturnTable.DataGrid.Reload();
    }

    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="GoodsReturnLineVM"
                                    @bind-Grid=@GoodsReturnTable.DataGrid
                                    @bind-GridSettings=@GoodsReturnTableSettings />,
        options: GridSettingsService.GetDialogOptions());

        await GoodsReturnTable.DataGrid.Reload();
    }
}