@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.Components.Security

@inherits BaseComponent
@layout ProtectedLayout
@attribute [AppAuthorizationAttribute("VIEW", "OIAJ")]
@attribute [Route(InventoryAdjustmentRoutes.INDEX)];


<PageTitle>Inventory Adjustment</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OIAJ" />
</RadzenStack>

<AppContent>
    <RadzenTabs @bind-SelectedIndex="@TabIndex" @bind-SelectedIndex:after="@OnTabChanged">
        <Tabs>
            <RadzenTabsItem Text="Goods Receipts">
                <QuickDataGrid DataGetter="@ReceiptsProvider" ActionName="@ActionGetInventoryAdjustment" Id="inventory_adjustment_receipt_datagrid">
                    <HeaderEnd>
                        <RadzenButton ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Icon="call_received" Text="Create Receipt" Click="@(() => NavManager.NavigateTo(InventoryAdjustmentRoutes.CREATE + "?type=receipt"))" />
                        <RadzenButton ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Icon="call_made" Text="Create Issue" Click="@(() => NavManager.NavigateTo(InventoryAdjustmentRoutes.CREATE + "?type=issue"))" />
                    </HeaderEnd>
                    <RowActions>
                        <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Click="() => ViewInventoryAdjustment(context)" />
                    </RowActions>
                </QuickDataGrid>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Goods Issues">
                <QuickDataGrid DataGetter="@IssuesProvider" ActionName="@ActionGetInventoryAdjustment" Id="inventory_adjustment_issue_datagrid">
                    <HeaderEnd>
                        <RadzenButton ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Icon="call_received" Text="Create Receipt" Click="@(() => NavManager.NavigateTo(InventoryAdjustmentRoutes.CREATE + "?type=receipt"))" />
                        <RadzenButton ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Icon="call_made" Text="Create Issue" Click="@(() => NavManager.NavigateTo(InventoryAdjustmentRoutes.CREATE + "?type=issue"))" />
                    </HeaderEnd>
                    <RowActions>
                        <RadzenButton Icon="arrow_right_alt" Size="ButtonSize.ExtraSmall" Click="() => ViewInventoryAdjustment(context)" />
                    </RowActions>
                </QuickDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</AppContent>