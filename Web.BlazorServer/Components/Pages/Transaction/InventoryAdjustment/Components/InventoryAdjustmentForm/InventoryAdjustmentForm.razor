@using Web.BlazorServer.Components.Custom
@using Web.BlazorServer.Components.Pages.Transaction.InventoryAdjustment.Components.Dialogs
@using Web.BlazorServer.Components.Pages.Transaction.Others
@using Web.BlazorServer.ViewModels.Others
@using Web.BlazorServer.ViewModels.Transaction.InventoryAdjustment
@inherits BaseComponent


<RadzenTemplateForm Data="@Model" EditContext="@EditContext" TItem="InventoryAdjustmentVM" Submit="OnValidSubmit">
    <RadzenFieldset Text="Details">
        <RadzenRow Gap="0.5em">
            <RadzenColumn SizeMD="6">
                <RadzenFormField AllowFloatingLabel="false" Text="Inventory Adjustment Number" class="rz-w-100">
                    <RadzenTextBox Disabled="Disabled" ReadOnly Value="@Model.ReferenceNumber" Placeholder="@(ReadOnly ? "-" : "Auto-Generated")" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn SizeMD="6">
                <RadzenFormField Text="Date" class="rz-w-100">
                    <RadzenDatePicker Disabled="Disabled" DateFormat="MMMM dd, yyyy" ShowTime="false" TValue="DateTime" ReadOnly Value="@Model.Date" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn SizeMD="6">
                <RadzenFormField Text="Subsidiary" class="rz-w-100">
                    <RadzenTextBox Disabled="Disabled" Visible="@ReadOnly" ReadOnly Value="@Model.Subsidiary?.Name" Placeholder="Enter subsidiary" />
                    <QuickVirtualizedDropdown Disabled="Disabled" Visible="@(!ReadOnly)" ActionName="@ActionGetSubsidiaries" TItem="SubsidiaryVM" @bind-Value:get="@Model.Subsidiary" @bind-Value:set="@SetSubsidiary" DataGetter="@SubsidiaryProvider" TextProperty="@nameof(SubsidiaryVM.Name)" AllowFiltering />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn SizeMD="6">
                <RadzenFormField Text="Location" class="rz-w-100">
                    <RadzenTextBox Disabled="Disabled" Visible="@ReadOnly" ReadOnly Value="@Model.Location?.Name" Placeholder="Enter location" />
                    <QuickVirtualizedDropdown @ref="@LocationDropdown" Visible="@(!ReadOnly)" Disabled="@(Model.Subsidiary is null || Disabled)" ActionName="@ActionGetLocations" TItem="LocationVM" @bind-Value="@Model.Location" DataGetter="@LocationProvider" TextProperty="@nameof(LocationVM.Name)" AllowFiltering AllowClear/>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn>
                <RadzenFormField Text="Adjustment Category" class="rz-w-100">
                    <RadzenTextBox ReadOnly Disabled="Disabled" Value="@Model.Category?.Name" Placeholder="Category not provided" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn SizeMD="4">
                <RadzenFormField Text="Adjustment Reason" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextBox Disabled="Disabled" Visible="@ReadOnly" ReadOnly Value="@Model.Reason?.Name" Placeholder="Enter adjustment reason" />
                        <QuickVirtualizedDropdown Disabled="Disabled" Visible="@(!ReadOnly)" ActionName="@ActionGetReasons" TItem="InventoryAdjustmentReasonVM" @bind-Value:get="@Model.Reason" @bind-Value:set="@SetReason" DataGetter="@ReasonProvider" TextProperty="@nameof(InventoryAdjustmentReasonVM.Name)" AllowFiltering AllowClear />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn SizeMD="4">
                <RadzenFormField Text="Account" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextBox Disabled="Disabled" Visible="@ReadOnly" ReadOnly Value="@Model.Account?.Name" Placeholder="Enter account" />
                        <QuickVirtualizedDropdown @ref="@AccountDropdown" Name="ia_account_dropdown" Visible="@(!ReadOnly)" Disabled="@(Model.Subsidiary is null || Disabled)" ActionName="@ActionGetAccounts" TItem="BusinessAccountVM" @bind-Value="@Model.Account" DataGetter="@AccountProvider" TextProperty="@nameof(BusinessAccountVM.Name)" AllowFiltering AllowClear />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="ia_account_dropdown" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
    </RadzenFieldset>
    <RadzenFieldset Text="Lines">
        <AppTableWithSettings Id="inventory_adjustment_lines" Data="@Model.Lines">
            <HeaderTemplate>
                <RadzenButton Visible="@(!ReadOnly)" Disabled="@(Model.Location is null || Disabled)" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@OpenItemDialog" />
            </HeaderTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="InventoryAdjustmentLineVM" Property="@nameof(InventoryAdjustmentLineVM.ItemCode)" Title="Item Code" />
                <RadzenDataGridColumn TItem="InventoryAdjustmentLineVM" Property="@nameof(InventoryAdjustmentLineVM.ItemDescription)" Title="Item Description" />
                <RadzenDataGridColumn TItem="InventoryAdjustmentLineVM" Property="@nameof(InventoryAdjustmentLineVM.Location)" Title="Warehouse">
                    <Template Context="data">
                        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">

                        <RadzenText Visible="@ReadOnly" TextStyle="TextStyle.Body2">@(data.Location?.Name ?? "No location data")</RadzenText>
                        <QuickVirtualizedDropdown Visible="@(!ReadOnly)" Disabled="@(Model.Subsidiary is null || Disabled)" ActionName="@ActionGetLocations" TItem="LocationVM" @bind-Value="@data.Location" DataGetter="@LocationProvider" TextProperty="@nameof(LocationVM.Name)" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InventoryAdjustmentLineVM" Property="@nameof(InventoryAdjustmentLineVM.UoM)" Title="UoM" >
                    <Template Context="data">
                        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">
                            <RadzenText Visible="@ReadOnly" TextStyle="TextStyle.Body2">@(data.UoM?.Name ?? "No unit data")</RadzenText>
                            <QuickVirtualizedDropdown Disabled="Disabled" Visible="@(!ReadOnly)" ActionName="@ActionGetItemUnits" TItem="ItemUnitVM" @bind-Value:get="@data.UoM" @bind-Value:set="@(val => LineSetUoM(data,val))" DataGetter="@(intent => UnitsProvider(data.ItemId, intent))" TextProperty="@nameof(ItemUnitVM.Name)" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Visible="@ReadOnly" TItem="InventoryAdjustmentLineVM" Type="typeof(decimal)" Property="@nameof(InventoryAdjustmentLineVM.QuantityOld)" Title="On hand Quantity" FormatString="{0:#,##0.##}"/>
                <RadzenDataGridColumn Visible="@(!ReadOnly)" TItem="InventoryAdjustmentLineVM" Type="typeof(decimal)" Property="@nameof(InventoryAdjustmentLineVM.QuantityOnHandByUoM)" Title="On hand Quantity" FormatString="{0:#,##0.##}" />
                <RadzenDataGridColumn TItem="InventoryAdjustmentLineVM" Property="@nameof(InventoryAdjustmentLineVM.QuantityAlloted)" Title="Alloted Quantity">
                    <Template Context="data">
                        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">

                        <RadzenText Visible="@ReadOnly" TextStyle="TextStyle.Body2">@data.QuantityAlloted.ToString("#,##0.##")</RadzenText>
                        <RadzenButton Icon="assignment_turned_in"
                                          ButtonStyle="ButtonStyle.Success"
                                          Size="ButtonSize.ExtraSmall"
                                          Disabled="Disabled"
                                          Visible="@(ReadOnly && data.ItemUsesBins)"
                                          Click="_ => OpenInventoryDetailDialog(data)" />

                        <RadzenFormField Text="@(data.Type == InventoryAdjustmentLineVM.Types.Issue ? "Issue" : "Receipt")" Visible="@(!ReadOnly)">
                            <ChildContent>
                                <RadzenNumeric Disabled="Disabled" ReadOnly="@ReadOnly" Name="line_details" @bind-Value="@data.QuantityAlloted" class="rz-w-100" Min="0" Max="@(data.QuantityAllotedMax)" Format="#,##0.##" />
                            </ChildContent>
                            <End>
                                <RadzenButton Icon="@((data.IsAllAssignedToBins || ReadOnly) ? "assignment_turned_in" : "assignment_returned")"
                                              ButtonStyle="@((data.IsAllAssignedToBins || ReadOnly)  ? ButtonStyle.Success : ButtonStyle.Warning)"
                                              Size="ButtonSize.ExtraSmall" 
                                              Disabled="Disabled"
                                              Visible="@(data.ItemUsesBins)"
                                              Click="_ => OpenInventoryDetailDialog(data)" />
                            </End>
                            <Helper>
                                @if (!ReadOnly)
                                {
                                    <RadzenCustomValidator Component="line_details"
                                                           Validator="@(() => data.InventoryDetails.Sum(x => x.QuantityAlloted) == data.QuantityAlloted)"
                                                           Text="Assign Inventory Details" />
                                    <RadzenCustomValidator Component="line_details"
                                                           Validator="@(() => data.QuantityAlloted > 0)"
                                                           Text="Assign Quantity" />
                                    <RadzenCustomValidator Component="line_details"
                                                           Validator="@(() => data.QuantityAlloted <= data.QuantityOnHandByUoM)"
                                                           Text="Assign Quantity" />
                                }
                            </Helper>
                        </RadzenFormField>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Visible="@ReadOnly" TItem="InventoryAdjustmentLineVM" Property="@nameof(InventoryAdjustmentLineVM.QuantityOnHandByUoM)" FormatString="{0:#,##0.##}" Title="New Quantity" />
                <RadzenDataGridColumn Visible="@(!ReadOnly)" TItem="InventoryAdjustmentLineVM" Property="@nameof(InventoryAdjustmentLineVM.QuantityNew)" FormatString="{0:#,##0.##}" Title="New Quantity" />
                @if (!ReadOnly)
                {
                    <RadzenDataGridColumn TItem="InventoryAdjustmentLineVM"
                                          Frozen
                                          FrozenPosition="FrozenColumnPosition.Right"
                                          Width="35px"
                                          Filterable="false" Sortable="false" Pickable="false">
                        <Template Context="data">
                            <RadzenButton Disabled="Disabled" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Click="_ => DeleteLine(data)" />
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </AppTableWithSettings>
    </RadzenFieldset>
    <RadzenFieldset Text="Additional Details">
        <RadzenRow>
            <RadzenColumn SizeMD="4">
                <RadzenFormField Text="Remarks" class="rz-w-100">
                    <RadzenTextArea Disabled="Disabled" ReadOnly="@ReadOnly" @bind-Value="@Model.Memo" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn SizeMD="4" OffsetMD="4">
                <RadzenFormField Text="Prepared By" class="rz-w-100">
                    <RadzenTextBox Disabled="Disabled" ReadOnly Value="@Model.PreparedBy" Placeholder="@(ReadOnly ? " - " : "Auto Generated")" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
    </RadzenFieldset>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5em" JustifyContent="JustifyContent.SpaceBetween" class="rz-mt-3">
        <RadzenButton Disabled="Disabled" ButtonType="ButtonType.Button" Text="@ReturnString" Click="ReturnClicked" ButtonStyle="ButtonStyle.Light" />
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5em">
            <RadzenButton Disabled="Disabled" ButtonType="ButtonType.Button" Visible="OnSecondaryActionClicked.HasDelegate" Text="@SecondaryActionString" Click="SecondaryActionClicked" />
            <RadzenButton Disabled="Disabled" ButtonType="ButtonType.Submit" Visible="OnSubmit.HasDelegate" Text="@SubmitString" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {

    async Task OpenItemDialog()
    {
        List<ItemsVM> items = await DialogService.OpenAsync(
            "Select Items",
            ds => @<ItemSelection Location="@(Model.Location?.Id ?? null)" IsReceipt="@(!Issue)" />,
    options: GridSettingsService.GetDialogOptions());

        if (items is not null) await AddItems(items);
    }
    readonly DialogOptions InventoryDetailDialogOpts = new()
        {
            CloseDialogOnOverlayClick = true,
            CloseDialogOnEsc = true,
            Draggable = true,
            Resizable = true,
            Width = "80%",
            ShowClose = true
        };

    async Task OpenInventoryDetailDialog(InventoryAdjustmentLineVM line)
    {
        if (line.QuantityAlloted <= 0)
        {
            ToastService.Error("Assign alloted quantity first");
            return;
        }
        if (line.Location is null) {
            ToastService.Error("Please set a location");
            return;
        }

        Tuple<int, int>? DetailsId = (line.LineNumber is null) ?
            null :
            Tuple.Create(Model.Id, (int)line.LineNumber);

        InventoryDetailsDialog.Types Type = Issue ?
            InventoryDetailsDialog.Types.Outgoing : 
            InventoryDetailsDialog.Types.Incoming;

        List<InventoryDetailVM> items = await DialogService.OpenAsync(
            "Set Inventory Details",
            ds => @<InventoryDetailsDialog LocationId="@line.Location.Id" Amount="@line.QuantityAlloted" Type="Type" ItemId="@line.ItemId" InventoryDetails="@line.InventoryDetails" LoadInventoryDetails="DetailsId" ReadOnly="ReadOnly"/>,
    options: InventoryDetailDialogOpts);

        if (items is not null)
        {
            line.InventoryDetails = [.. items];
            await InvokeAsync(StateHasChanged);
        }
    }
}