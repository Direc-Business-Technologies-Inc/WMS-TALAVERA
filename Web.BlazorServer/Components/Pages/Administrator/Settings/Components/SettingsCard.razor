@using Web.BlazorServer.ViewModels.Administration.Settings
<RadzenCard>
    <RadzenRow Gap="0.5em">
        <RadzenColumn SizeSM="7" SizeLG="9" SizeXL="11">
            <RadzenStack Gap="0.5em">
                <RadzenText TextStyle="TextStyle.DisplayH6">@Setting.Title</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@Setting.Description</RadzenText>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn SizeSM="5" SizeLG="3" SizeXL="1">
            <RadzenFormField class="rz-w-100">
                @if (Setting.Type == SettingsVM.Types.String)
                {
                    <RadzenTextBox @bind-Value="Setting.Value" />
                }
                else if (Setting.Type == SettingsVM.Types.Integer)
                {
                    <RadzenNumeric @bind-Value="IntValue" TValue="int" />
                }
                else if (Setting.Type == SettingsVM.Types.Decimal)
                {
                    <RadzenNumeric @bind-Value="DecimalValue" TValue="decimal"/>
                }
                else
                {
                    <RadzenTextBox Value="@Setting.Value" ReadOnly />
                }
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

@code {
    [Parameter][EditorRequired] public SettingsVM Setting { get; set; }
    int _intValue;
    decimal _decimalValue;

    int IntValue
    {
        get => _intValue;
        set
        {
            _intValue = value;
            Setting.Value = _intValue.ToString();
        }
    }

    decimal DecimalValue
    {
        get => _decimalValue;
        set
        {
            _decimalValue = value;
            Setting.Value = _decimalValue.ToString();
        }
    }
}