@using Web.BlazorServer.ViewModels.Administration.Settings
<RadzenCard>
    <RadzenRow Gap="0.5em">
        <RadzenColumn SizeSM="9" SizeXL="11">
            <RadzenStack Gap="0.5em">
                <RadzenText TextStyle="TextStyle.DisplayH6">@Setting.Title</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@Setting.Description</RadzenText>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn SizeSM="3" SizeXL="1">
            <RadzenFormField class="rz-w-100">
                @if (Setting.Type == SettingsVM.Types.String)
                {
                    <RadzenTextBox @bind-Value:get="@Setting.Value" @bind-Value:set="ValueSet" ReadOnly="@ReadOnly"/>
                }
                else if (Setting.Type == SettingsVM.Types.Integer)
                {
                    <RadzenNumeric @bind-Value:get="IntValue" @bind-Value:set="IntValueSet" TValue="int" ReadOnly="@ReadOnly"/>
                }
                else if (Setting.Type == SettingsVM.Types.Decimal)
                {
                    <RadzenNumeric @bind-Value:get="DecimalValue" @bind-Value:set="DecimalValueSet" TValue="decimal" ReadOnly="@ReadOnly"/>
                }
                else
                {
                    <RadzenTextBox Value="@Setting.Value" ReadOnly />
                }
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

@code {
    [Parameter][EditorRequired] public SettingsVM Setting { get; set; }
    [Parameter] public EventCallback<SettingsVM> SettingChanged { get; set; }
    [Parameter] public bool ReadOnly {get; set;} = false;
    int _intValue;
    decimal _decimalValue;

    decimal DecimalValue => decimal.TryParse(Setting.Value, out decimal decval) ? decval : 0;
    int IntValue => int.TryParse(Setting.Value, out int intval) ? intval : 0;

    async Task DecimalValueSet(decimal value) 
    {
        Setting.Value = value.ToString() ?? "0";
        await SettingChanged.InvokeAsync(Setting);
    }

    async Task IntValueSet(int value)
    {
        Setting.Value = value.ToString() ?? "0";
        await SettingChanged.InvokeAsync(Setting);
    }

    async Task ValueSet(string? value)
    {
        Setting.Value = value ?? string.Empty;
        await SettingChanged.InvokeAsync(Setting);
    }
}