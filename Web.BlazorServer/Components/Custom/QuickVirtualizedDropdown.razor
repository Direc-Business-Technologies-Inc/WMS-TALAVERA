@typeparam TItem
@inherits BaseComponent
<RadzenDropDown @ref="Dropdown" 
                Data="@Data" 
                @bind-Value:get="@Value"
                @bind-Value:set="@(value => ValueChanged.InvokeAsync(value))"
                LoadData="@LoadDataAsync" 
                Count="DataCount" 
                Name="@Name"
                Disabled="@Disabled"
                Visible="@Visible"
                ReadOnly="@ReadOnly"
                AllowVirtualization 
                AllowClear="@AllowClear"
                TextProperty="@TextProperty"
                ValueProperty="@ValueProperty"
                AllowFiltering="@AllowFiltering" >
    <HeaderTemplate>
        @if (ShowLoadingIndicator && IsBusy)
        {
            if (LoadingIndicator is not null)
            {
                @LoadingIndicator
            }
            else
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Value="100" ShowValue="false" class="rz-w-100" Style="height: 6px" />
            }
        }
    </HeaderTemplate>
</RadzenDropDown>