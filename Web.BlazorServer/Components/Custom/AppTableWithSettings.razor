@using Web.BlazorServer.Services.Repositories
@inherits BaseComponent
@typeparam TItem where TItem : class

<AppTable @ref="@Table" Id="@Id" TItem="@TItem" @bind-GridSettingsLoaded="@GridSettingsLoaded" Data="[..Data]">
    <HeaderTemplate>

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End"
                     AlignItems="AlignItems.Center"
                     Gap="8px">
            @if (HeaderTemplate is not null)
            {
                @HeaderTemplate
            }
            <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
        </RadzenStack>
    </HeaderTemplate>
    <Template Context="Item">
        @if (Template is not null)
        {
            @Template(Item)
        }
    </Template>
    <Footer>
        @if (Footer is not null)
        {
            @Footer
        }
    </Footer>
    <Columns>
        @if (Columns is not null)
        {
            @Columns
        }
    </Columns>
    <LoadingTemplate>
        @if (LoadingTemplate is not null)
        {
            @LoadingTemplate
        }
    </LoadingTemplate>
    <EmptyTemplate>
        @if (EmptyTemplate is not null)
        {
            @EmptyTemplate
        }
    </EmptyTemplate>
</AppTable>

@code {

    // to be honest. idk what i was trying to do here
    // this whole thing was very patchwork-y
    // i blame not having better requirement gathering
    // i also blame myself :(
    [Parameter][EditorRequired] public required string Id { get; set; }
    [Parameter] public List<TItem> Data { get; set; } = new List<TItem>();

    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
    [Parameter] public RenderFragment<TItem>? Template { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? LoadingTemplate { get; set; }
    [Parameter] public RenderFragment? EmptyTemplate { get; set; }
    [Parameter] public RenderFragment? Columns { get; set; }
    [Parameter] public bool IgnoreSettingsPageData { get; set; } = true;

    [Inject] IGridSettingsService GridSettingsService { get; set; } = default!;

    public AppTable<TItem> Table { get; private set; } = default!;
    public RadzenDataGrid<TItem> DataGrid => Table.DataGrid;

    bool GridSettingsLoaded { get; set; } = false;

    DataGridSettings TableSettings { get; set; } = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender && !GridSettingsLoaded)
        {
            await GridSettingsService.SetGridSettings(Table.DataGrid, settings => TableSettings = settings ?? new());
            if (IgnoreSettingsPageData) TableSettings.CurrentPage = null;

            GridSettingsLoaded = true;

            await Table.DataGrid.ReloadSettings();
            await Table.DataGrid.Reload();
            await InvokeAsync(StateHasChanged);
        }
    }

    
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="TItem"
                                    @bind-Grid=@Table.DataGrid
                                    @bind-GridSettings=@TableSettings />
    ,
        options: GridSettingsService.GetDialogOptions());

        await Table.DataGrid.Reload();
    }
}
