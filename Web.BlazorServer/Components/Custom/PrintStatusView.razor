@implements IDisposable
@using Application.DataTransferObjects.Transactions

<nav class="print-status-tabs" aria-label="Print status views" aria-busy="@isRefreshing.ToString().ToLowerInvariant()">
    <button type="button" class="print-status-tab for-printing @(SelectedIndex == 0 ? "active" : null)"
            aria-pressed="@(SelectedIndex == 0)" disabled="@Disabled" @onclick="() => SelectAsync(PrintStatus.ForPrinting)">
        <RadzenIcon Icon="print" />
        <strong>@(ForPrintingCount?.ToString() ?? "—")</strong>
        <span>For Printing</span>
    </button>
    <button type="button" class="print-status-tab printed @(SelectedIndex == 1 ? "active" : null)"
            aria-pressed="@(SelectedIndex == 1)" disabled="@Disabled" @onclick="() => SelectAsync(PrintStatus.Printed)">
        <RadzenIcon Icon="check_circle" />
        <strong>@(PrintedCount?.ToString() ?? "—")</strong>
        <span>Printed</span>
    </button>
    <button type="button" class="print-status-tab all @(SelectedIndex == 2 ? "active" : null)"
            aria-pressed="@(SelectedIndex == 2)" disabled="@Disabled" @onclick="() => SelectAsync(PrintStatus.All)">
        <span>All</span>
    </button>
    @if (isRefreshing)
    {
        <span role="status" aria-live="polite"><RadzenIcon Icon="hourglass_top" /> Updating counts…</span>
    }
</nav>
@if (CountsStale)
{
    <div role="alert">Counts could not be refreshed; displayed totals are stale.
        <button type="button" @onclick="RefreshCountsAsync">Retry counts</button>
    </div>
}

@code {
    [Parameter] public PrintStatus Value { get; set; } = PrintStatus.ForPrinting;
    [Parameter] public EventCallback<PrintStatus> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Func<PrintStatus, Task<int>>? CountGetter { get; set; }
    [Parameter] public Func<CancellationToken, Task<PrintStatusCountsDTO>>? CountsGetter { get; set; }
    [Parameter] public bool LoadCountsOnInitialize { get; set; } = true;
    [Parameter] public bool RefreshCountsOnSelect { get; set; } = true;

    private int? ForPrintingCount;
    private int? PrintedCount;
    private int refreshVersion;
    private bool disposed;
    private bool isRefreshing;
    public bool CountsStale { get; private set; }
    private bool refreshPending;
    private Task? refreshTask;
    private CancellationTokenSource? refreshCancellation;

    private int SelectedIndex => (int)Value;

    protected override async Task OnInitializedAsync()
    {
        if (LoadCountsOnInitialize) await RefreshCountsAsync();
    }

    public Task RefreshCountsAsync()
    {
        if (disposed || Disabled || (CountGetter is null && CountsGetter is null)) return Task.CompletedTask;

        ++refreshVersion;
        refreshPending = true;
        refreshCancellation?.Cancel();
        if (refreshTask is null || refreshTask.IsCompleted)
            refreshTask = RefreshPendingCountsAsync();
        return refreshTask;
    }

    private async Task RefreshPendingCountsAsync()
    {
        // Keep one active refresh and only the newest pending refresh. Cancellation
        // reaches the aggregate query; version checks also protect legacy getters.
        while (refreshPending && !disposed)
        {
            refreshPending = false;
            var version = refreshVersion;
            using var cancellation = new CancellationTokenSource();
            refreshCancellation = cancellation;
            // Keep the last successful totals visible during reconciliation.
            isRefreshing = true;
            try
            {
                await InvokeAsync(StateHasChanged);
                if (CountsGetter is not null)
                {
                    var counts = await CountsGetter(cancellation.Token);
                    if (disposed || version != refreshVersion) continue;
                    ForPrintingCount = counts.ForPrinting;
                    PrintedCount = counts.Printed;
                    CountsStale = false;
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    var successes = await Task.WhenAll(
                        LoadCountAsync(PrintStatus.ForPrinting, version),
                        LoadCountAsync(PrintStatus.Printed, version));
                    if (!disposed && version == refreshVersion) CountsStale = successes.Any(success => !success);
                }
            }
            catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
            catch (Exception ex)
            {
                if (!disposed && version == refreshVersion) CountsStale = true;
                Logger.LogWarning(ex, "Could not load print-status counts");
            }
            finally
            {
                refreshCancellation = null;
                isRefreshing = false;
                if (!disposed) await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task<bool> LoadCountAsync(PrintStatus status, int version)
    {
        try
        {
            var count = await CountGetter!(status);
            await InvokeAsync(() =>
            {
                if (disposed || version != refreshVersion) return;
                if (status == PrintStatus.ForPrinting) ForPrintingCount = count;
                else PrintedCount = count;
                StateHasChanged();
            });
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load {PrintStatus} count", status);
            await InvokeAsync(() =>
            {
                if (disposed || version != refreshVersion) return;
                CountsStale = true;
                StateHasChanged();
            });
            return false;
        }
    }

    private async Task SelectAsync(PrintStatus status)
    {
        if (!Disabled && status != Value)
        {
            await ValueChanged.InvokeAsync(status);
            if (RefreshCountsOnSelect) await RefreshCountsAsync();
        }
    }

    [Inject] private ILogger<PrintStatusView> Logger { get; set; } = default!;

    public async Task RefreshCountsOrThrowAsync()
    {
        await RefreshCountsAsync();
        if (disposed || CountsStale) throw new InvalidOperationException("Refresh needed. Retry counts.");
    }

    public void Dispose()
    {
        disposed = true;
        ++refreshVersion;
        refreshCancellation?.Cancel();
    }
}
