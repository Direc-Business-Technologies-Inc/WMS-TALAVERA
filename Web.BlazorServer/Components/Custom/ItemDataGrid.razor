@using Web.BlazorServer.ViewModels.Others
@inherits BaseComponent

<AppDataGrid TItem="ItemsVM" @ref="@DataGrid" Id="@Id" GridSettings="@DataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" ActionName="@ActionGetItems" DataGetter="@LoadDataAsync">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="8px">
            <!-- Search -->
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="4px">

                <RadzenTextBox @bind-Value="@SearchText"
                               Placeholder="Search items..."
                               Style="width: 250px;"
                               Change="@OnSearchChanged" />

                @if (!string.IsNullOrWhiteSpace(SearchText))
                {
                    <RadzenButton Icon="close"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@ClearSearch" />
                }

            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="4px">
                <SelectAllHeader Value="@GetSelectionHeaderState()"
                                 OnChange="@ToggleAllItems"
                                 Disabled="@(SelectionMode != SelectionModes.Multiple)"
                                 ShowCheckbox="false" />
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="DataGrid.ReloadDataAsync" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        <RadzenDataGridColumn TItem="ItemsVM" Property="@nameof(ItemsVM.ItemNumber)" Title="Item Id" />
        <RadzenDataGridColumn TItem="ItemsVM" Property="@nameof(ItemsVM.Name)" Title="Name " />
        <RadzenDataGridColumn TItem="ItemsVM" Property="@nameof(ItemsVM.Description)" Title="Description " />
        <RadzenDataGridColumn TItem="ItemsVM" Type="typeof(decimal)" FormatString="{0:#,##0.##}" Property="@nameof(ItemsVM.QuantityOnHand)" Title="On-Hand Quantity" />
        <RadzenDataGridColumn TItem="ItemsVM" Type="typeof(decimal)" FormatString="{0:#,##0.##}" Property="@nameof(ItemsVM.QuantityAvailable)" Title="Available Quantity" />
        <RadzenDataGridColumn TItem="ItemsVM"
                              Frozen
                              FrozenPosition="FrozenColumnPosition.Right"
                              Width="35px"
                              Filterable="false" Sortable="false" Pickable="false">
            <HeaderTemplate>
                <SelectAllHeader Value="@GetSelectionHeaderState()"
                                 OnChange="@ToggleAllItems"
                                 Disabled="@(SelectionMode != SelectionModes.Multiple)"
                                 ShowButton="false"
                                 CheckboxName="items_datagrid_select_all" />
            </HeaderTemplate>
            <Template>
                <RadzenCheckBox TValue="bool"
                                Value="@(SelectedItems.Any(x => x.ItemNumber == context.ItemNumber))"
                                Change="@(_ => SelectItem(context))" />
            </Template>
        </RadzenDataGridColumn>
    </GridColumns>
</AppDataGrid>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5em" Visible="@(SelectionMode == SelectionModes.Multiple)" class="rz-mt-3 rz-w-100">
        <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" Text="Clear Selection" Click="@(_ => SelectedItems.Clear())" />
        <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Success" Text="Select" Click="@Submit" />
    </RadzenStack>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="ItemsVM"
                                    @bind-Grid=@DataGrid.DataGrid
                                    @bind-GridSettings=@DataGridSettings />,
        options: GridSettingsService.GetDialogOptions());

        await DataGrid.DataGrid.Reload();
    }
}