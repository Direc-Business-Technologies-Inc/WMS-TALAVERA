@inherits BaseComponent
@implements IAsyncDisposable

@if (Notifications.Count > 0)
{
    <div class="bf-notifications" aria-live="polite" aria-label="Bulk fulfillment notifications">
        @foreach (var notification in Notifications)
        {
            <div @key="(notification.RequestId, notification.Sequence)" class="bf-notification @(notification.Status == "Done" ? "bf-done" : "bf-failed")" role="status">
                <strong>Bulk fulfillment #@notification.BulkFulfillmentId — @notification.Status</strong>
                <p>@(notification.Status == "Done" ? "Item Fulfillments are available in NetSuite." : "NetSuite reported a processing failure. Review the details before retrying; some IFs may already exist.")</p>
                @if (!string.IsNullOrWhiteSpace(notification.Message))
                {
                    <p class="bf-details">@notification.Message</p>
                }
                <button type="button" class="bf-dismiss" aria-label="@($"Dismiss bulk fulfillment {notification.BulkFulfillmentId} notification")"
                        disabled="@Dismissing" @onclick="() => DismissAsync(notification)">Dismiss</button>
            </div>
        }
    </div>
}
