@using Mobile.MAUI.Components.Base
@inherits BaseComponent
<RadzenStack class="mt-4 rz-px-2">
    <RadzenTextBox Value="@SearchText" Placeholder="Scan or enter authorization number" Style="width:100%" @oninput="OnSearchInput" @onkeydown="HandleEnter" />
    <RadzenButton Text="Find" Icon="search" Click="SubmitLookup" Disabled="@IsLoading" />
    @if (IsLoading) { <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" /> }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage)) { <RadzenText Text="@ErrorMessage" class="rz-color-danger" /> }
</RadzenStack>
