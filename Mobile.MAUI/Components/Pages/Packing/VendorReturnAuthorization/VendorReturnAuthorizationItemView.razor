@page "/packing/vra/{OrderNumber}"
@using Mobile.MAUI.Components.Base
@using Shared.Libraries.ViewModel.VendorReturnAuthorization
@using static MAUI.Helpers.FormatHelper

@layout CleanLayout
@inherits BaseComponent

<RadzenStack Gap="12px" Style="">
    <PageHeading Title="RTS" BackPath="/packing" Click="Refresh" Id="@($"{OrderNumber}")" />
    <RadzenStack id="recent-scanned" class="box-toolbar-page">

    </RadzenStack>

    <RadzenStack id="recent-scanned-floating" class="recent-scanned-floating">

        <RadzenStack Visible="@(LastScanned is not null)" Style="position:relative;" class="rz-p-4" Orientation="Orientation.Horizontal">
            <RadzenStack Gap="4px">
                <RadzenText Text="@LastScanned.MaterialName" TextStyle="TextStyle.Subtitle2" Style="font-size:.75rem" />
                <RadzenText Text="@LastScanned.LocationName" TextStyle="TextStyle.Subtitle2" Style="font-size:.6rem" />
                <RadzenText Text="@LastScanned.UoMName" TextStyle="TextStyle.Subtitle2" Style="font-size:.6rem" />
                <RadzenText Text="@($"Available Qty: {LastScanned.GoodPerUomRate}")" TextStyle="TextStyle.Subtitle2" Style="font-size:.6rem" />
            </RadzenStack>

            <RadzenStack Gap="0" Style="position:absolute;right:0;top:0;width:max-content;height:100%;overflow:clip" AlignItems="AlignItems.End">

                <RadzenStack Style="flex-grow:1"
                             class="@($"dynamic-qty-box {(LastScanned.AlreadyPacked ? "rz-background-color-success" : "rz-background-color-warning")}")">
                    <RadzenText Text="@FormatQuantity(LastScanned.ScannedQuantity)"
                                Style="font-size:1.25rem;font-weight:500;"
                                class="@($"dynamic-qty-text {(LastScanned.AlreadyPacked ? "rz-color-white" : "")}")" />
                </RadzenStack>
                <RadzenStack Style="flex-grow:1;"
                             class="dynamic-qty-box rz-background-color-base-200">
                    <RadzenText Text="@FormatQuantity(LastScanned.NSLineQuantityPacked)"
                                Style="font-size:1.25rem;font-weight:500;"
                                class="dynamic-qty-text" />
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal"
                         Gap="6px"
                         Style="position:absolute;left:16px;bottom:8px;align-items:center;">

                <RadzenBadge BadgeStyle="@(LastScanned.IsBad? BadgeStyle.Danger: BadgeStyle.Success)"
                             Text="@(LastScanned.IsBad ? "Bad" : "Good")" />

                <RadzenBadge BadgeStyle="BadgeStyle.Info"
                             Text="Last Scanned" />

            </RadzenStack>
        </RadzenStack>

    </RadzenStack>

    <Loading IsLoading="ActionGetVRAItems.Busy" Text="Loading RTS Items...">
        <ChildContent>  
            <RadzenStack>

                <RadzenStack Gap="8px" class="rz-px-2 rz-mb-2">
                    <RadzenTextBox Value="@SearchText"
                                   Placeholder="Search by material code, name, location or UoM.."
                                   Style="width:100%;"
                                   @oninput="@OnSearchInput" />

                    @if (!string.IsNullOrWhiteSpace(SearchText))
                    {
                        <RadzenButton Text="Clear Search"
                                      Icon="close"
                                      ButtonStyle="ButtonStyle.Base"
                                      Size="ButtonSize.Small"
                                      Click="@ClearSearch" />
                    }
                </RadzenStack>

                <RadzenTabs @bind-SelectedIndex="ActiveTabIndex">
                    <Tabs>
                        <RadzenTabsItem Text="Good">
                            <RadzenDataList TItem="VendorReturnAuthorizationLineVM" Data="FilteredGoodVRAItems.Where(x => x.NSLineQuantityPacked != 0)" Style="margin-bottom:200px">
                                <Template Context="row">
                                    <RadzenStack Style="position:relative;overflow:clip !important;" class="@(IsSelectedGood(row) ? "rz-p-2 selected-row" : "rz-p-2")" Orientation="Orientation.Horizontal"
                                                 @onclick="@(() => SelectGoodLine(row))">
                                        <RadzenStack Gap="4px">
                                            <RadzenText Text="@row.MaterialName" TextStyle="TextStyle.Subtitle2" Style="font-size:.75rem" />
                                            <RadzenText Text="@row.LocationName" TextStyle="TextStyle.Subtitle2" Style="font-size:.6rem" />
                                            <RadzenText Text="@row.UoMName" TextStyle="TextStyle.Subtitle2" Style="font-size:.6rem" />
                                            <RadzenText Text="@($"Available Qty: {row.GoodPerUomRate}")" TextStyle="TextStyle.Subtitle2" Style="font-size:.6rem" />
                                        </RadzenStack>

                                        <RadzenStack Gap="0" Style="position:absolute;right:0;top:0;width:max-content;height:100%;overflow:clip" AlignItems="AlignItems.End">

                                            <RadzenStack Style="flex-grow:1"
                                                         class="@($"dynamic-qty-box {(row.AlreadyPacked ? "rz-background-color-success" : "rz-background-color-warning")}")">
                                                <RadzenText Text="@FormatQuantity(row.ScannedQuantity)"
                                                            Style="font-size:1.25rem;font-weight:500;"
                                                            class="@($"dynamic-qty-text {(row.AlreadyPacked ? "rz-color-white" : "")}")" />
                                            </RadzenStack>
                                            <RadzenStack Style="flex-grow:1;"
                                                         class="dynamic-qty-box rz-background-color-base-200">
                                                <RadzenText Text="@FormatQuantity(row.NSLineQuantityPacked)"
                                                            Style="font-size:1.25rem;font-weight:500;"
                                                            class="dynamic-qty-text" />
                                            </RadzenStack>
                                        </RadzenStack>
                                    </RadzenStack>
                                </Template>
                            </RadzenDataList>
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="Bad">
                            <RadzenDataList TItem="VendorReturnAuthorizationLineVM" Data="FilteredBadVRAItems.Where(x => x.ScannedQuantity != 0)" Style="margin-bottom:200px">
                                <Template Context="row">
                                    <RadzenStack Style="position:relative;overflow:clip !important;" class="@(IsSelectedBad(row) ? "rz-p-2 selected-row" : "rz-p-2")" Orientation="Orientation.Horizontal"
                                                 @onclick="@(() => SelectBadLine(row))">
                                        <RadzenStack Gap="4px">
                                            <RadzenText Text="@row.MaterialName" TextStyle="TextStyle.Subtitle2" Style="font-size:.75rem" />
                                            <RadzenText Text="@row.LocationName" TextStyle="TextStyle.Subtitle2" Style="font-size:.6rem" />
                                            <RadzenText Text="@row.UoMName" TextStyle="TextStyle.Subtitle2" Style="font-size:.6rem" />
                                            <RadzenText Text="@($"Available Qty: {row.BadPerUomRate}")" TextStyle="TextStyle.Subtitle2" Style="font-size:.6rem" />
                                        </RadzenStack>

                                        <RadzenStack Gap="0" Style="position:absolute;right:0;top:0;width:max-content;height:100%;overflow:clip" AlignItems="AlignItems.End">

                                            <RadzenStack Style="flex-grow:1"
                                                         class="@($"dynamic-qty-box {(row.AlreadyPacked ? "rz-background-color-success" : "rz-background-color-warning")}")">
                                                <RadzenText Text="@FormatQuantity(row.ScannedQuantity)"
                                                            Style="font-size:1.25rem;font-weight:500;"
                                                            class="@($"dynamic-qty-text {(row.AlreadyPacked ? "rz-color-white" : "")}")" />
                                            </RadzenStack>
                                            <RadzenStack Style="flex-grow:1;"
                                                         class="dynamic-qty-box rz-background-color-base-200">
                                                <RadzenText Text="@FormatQuantity(row.NSLineQuantityPacked)"
                                                            Style="font-size:1.25rem;font-weight:500;"
                                                            class="dynamic-qty-text" />
                                            </RadzenStack>
                                        </RadzenStack>
                                    </RadzenStack>
                                </Template>
                            </RadzenDataList>
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
                <RadzenCard class="floating-scan-actions rz-p-2 rz-border-radius-6">
                    <RadzenStack Gap="8px" Orientation="Orientation.Vertical">

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween"
                                     Gap="8px">

                            @if (!IsActionPanelCollapsed)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                                    Scan Actions
                                </RadzenText>
                            }

                            <RadzenButton Icon="@(IsActionPanelCollapsed ? "keyboard_arrow_up" : "keyboard_arrow_down")"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Base"
                                          Variant="Variant.Flat"
                                          Click="@ToggleActionPanel" />
                        </RadzenStack>

                        @if (!IsActionPanelCollapsed)
                        {
                            <RadzenStack Gap="8px" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">

                                <RadzenStack Gap="4px" Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" class="scan-action-item">
                                    <RadzenButton Class="rz-border-radius-5"
                                                  Icon="@ScanStateIcon"
                                                  ButtonStyle="@ScanStateButtonStyle"
                                                  Size="ButtonSize.Small"
                                                  Click="@ToggleScanState"
                                                  Disabled="@ActionSaveScan.Busy" />

                                    <RadzenText TextStyle="TextStyle.Caption"
                                                Class="scan-action-label rz-m-0">
                                        @ScanStateLabel
                                    </RadzenText>
                                </RadzenStack>

                                <RadzenStack Gap="4px" Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" class="scan-action-item">
                                    <RadzenButton class="rz-border-radius-5"
                                                  Icon="move_item"
                                                  ButtonStyle="@(MoveOn ? ButtonStyle.Success : ButtonStyle.Base)"
                                                  Size="ButtonSize.Small"
                                                  Click="@(args => ToggleMove())"
                                                  Disabled="@(ActionSaveScan.Busy || NegateQuantity)" />

                                    <RadzenText TextStyle="TextStyle.Caption" class="scan-action-label rz-m-0">
                                        Move
                                    </RadzenText>
                                </RadzenStack>

                                <RadzenStack Gap="4px" Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" class="scan-action-item">
                                    <RadzenButton class="rz-border-radius-5"
                                                  Icon="remove"
                                                  ButtonStyle="@(NegateQuantity ? ButtonStyle.Success : ButtonStyle.Base)"
                                                  Size="ButtonSize.Small"
                                                  Click="@(args => ToggleNegateQuantity())"
                                                  Disabled="@(ActionSaveScan.Busy || MoveOn)" />

                                    <RadzenText TextStyle="TextStyle.Caption" class="scan-action-label rz-m-0">
                                        Remove
                                    </RadzenText>
                                </RadzenStack>

                                @* <RadzenStack Gap="4px" Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" class="scan-action-item">
                                    <RadzenButton class="rz-border-radius-5"
                                                  Icon="balance"
                                                  ButtonStyle="ButtonStyle.Base"
                                                  Size="ButtonSize.Small"
                                                  Click="@(args => ToggleWeight())"
                                                  Disabled="@ActionSaveScan.Busy" />

                                    <RadzenText TextStyle="TextStyle.Caption" class="scan-action-label rz-m-0">
                                        Weight
                                    </RadzenText>
                                </RadzenStack> *@

                                @* <RadzenStack Gap="4px" Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" class="scan-action-item">
                                    <RadzenButton class="rz-border-radius-5"
                                                  Icon="draft"
                                                  ButtonStyle="@(ManualEntry ? ButtonStyle.Success : ButtonStyle.Base)"
                                                  Size="ButtonSize.Small"
                                                  Click="@(args => ToggleManualEntry())"
                                                  Disabled="@ActionSaveScan.Busy" />

                                    <RadzenText TextStyle="TextStyle.Caption" class="scan-action-label rz-m-0">
                                        Manual
                                    </RadzenText>
                                </RadzenStack> *@

                                <RadzenStack Gap="4px" Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" class="scan-action-item">
                                    <RadzenButton class="rz-border-radius-5"
                                                  Icon="@(ActionSaveScan.Busy ? "schedule" : "save")"
                                                  ButtonStyle="ButtonStyle.Success"
                                                  Size="ButtonSize.Small"
                                                  Click="@(async () => await SaveScan())"
                                                  Disabled="@(SaveBtnDisabled || ActionSaveScan.Busy)" />

                                    <RadzenText TextStyle="TextStyle.Caption" class="scan-action-label rz-m-0">
                                        Save
                                    </RadzenText>
                                </RadzenStack>

                            </RadzenStack>
                        }

                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
        </ChildContent>
    </Loading>

    <SavingLoading IsVisible="ActionSaveScan.Busy" Text="Saving scanned items..." />
</RadzenStack>