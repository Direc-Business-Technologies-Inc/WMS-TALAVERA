@using Shared.Libraries.ViewModel.TripTicket
@using Mobile.MAUI.Components.Base

@inherits BaseComponent

<RadzenTemplateForm TItem="TripTicketVM" Data="@Model" Submit="OnConfirm">

    <RadzenStack Gap="1rem">

        <RadzenFormField Text="Destination" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="Destination"
                                Multiple="true"
                                @bind-Value="Model.Destinations"
                                Data="@Destination"
                                TextProperty="LocationName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="Destination" Text="Destination is required" />

        <RadzenFormField Text="Truck Plate Number" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="TruckPlateNumber"
                                @bind-Value="Model.TruckPlateNumber"
                                Data="@TruckPlateNumbers"
                                TextProperty="TruckPlateNoName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="TruckPlateNumber" Text="Truck Plate Number is required" />

        <RadzenFormField Text="Assigned Driver" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="AssignedDriver"
                                @bind-Value="Model.Driver"
                                Data="@Drivers"
                                TextProperty="FullName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="AssignedDriver" Text="Assigned Driver is required" />

        <RadzenFormField Text="Trip Date" Style="width:100%">
            <ChildContent>
                <RadzenDatePicker Name="TripDate"
                                  @bind-Value="Model.TripDate"
                                  DateFormat="yyyy-MM-dd"
                                  Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="TripDate" Text="Trip Date is required" />

        <RadzenFormField Text="Helper" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="Helper"
                                @bind-Value="Model.Helper"
                                Data="@Helpers"
                                TextProperty="FullName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="Helper" Text="Helper is required" />

        <RadzenFormField Text="Origin Location" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="OriginLocation"
                                @bind-Value="Model.OriginLocation"
                                Data="@OriginLocations"
                                TextProperty="LocationName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="OriginLocation" Text="Origin Location is required" />

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="8px">
            <RadzenButton Text="Cancel" Click="OnCancel" ButtonStyle="ButtonStyle.Warning" />
            <RadzenButton Text="Confirm" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" />
        </RadzenStack>

    </RadzenStack>

</RadzenTemplateForm>