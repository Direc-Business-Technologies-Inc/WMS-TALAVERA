@using Shared.Libraries.ViewModel.TripTicket
@using Mobile.MAUI.Components.Base

@inherits BaseComponent

<RadzenTemplateForm TItem="TripTicketVM" Data="@Model" Submit="OnConfirm" Style="height:calc(100vh - 120px); overflow-y:auto; overflow-x:hidden;">

    <RadzenStack Gap="1rem">

        <RadzenFormField Text="To Subsidiary" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="ToSubsidiary"
                                Multiple="true"
                                @bind-Value="Model.ToSubsidiaries"
                                Data="@Subsidiaries"
                                TextProperty="SubsidiaryName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="ToSubsidiary" Text="To Subsidiary is required" />

        <RadzenFormField Text="From Subsidiary" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="FromSubsidiary"
                                @bind-Value="Model.FromSubsidiary"
                                Data="@Subsidiaries"
                                TextProperty="SubsidiaryName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="FromSubsidiary" Text="From Subsidiary is required" />

        <RadzenFormField Text="Destination" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="Destination"
                                Multiple="true"
                                @bind-Value="Model.Destinations"
                                Data="@Destination"
                                TextProperty="LocationName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="Destination" Text="Destination is required" />

        @if (Model.Destinations?.Any() == true)
        {
            <RadzenText TextStyle="TextStyle.Body2"
                        Style="margin-top:-8px; margin-bottom:8px; color:#666;">
                <strong>Route:</strong><br />

                @foreach (var (destination, index) in Model.Destinations
                            .OrderBy(x => x.RoutingPriority)
                            .Select((x, index) => (x, index)))
                {
                    <div>@(index + 1). @destination.LocationName</div>
                }
            </RadzenText>
        }

        <RadzenFormField Text="Truck Plate Number" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="TruckPlateNumber"
                                @bind-Value="Model.TruckPlateNumber"
                                Data="@TruckPlateNumbers"
                                TextProperty="TruckPlateNoName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="TruckPlateNumber" Text="Truck Plate Number is required" />

        <RadzenFormField Text="Assigned Driver" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="AssignedDriver"
                                @bind-Value="Model.Driver"
                                Data="@Drivers"
                                TextProperty="FullName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="AssignedDriver" Text="Assigned Driver is required" />

        <RadzenFormField Text="Trip Date" Style="width:100%">
            <ChildContent>
                <RadzenDatePicker Name="TripDate"
                                  @bind-Value="Model.TripDate"
                                  DateFormat="yyyy-MM-dd"
                                  Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="TripDate" Text="Trip Date is required" />

        <RadzenFormField Text="Helper" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="Helper"
                                @bind-Value="Model.Helper"
                                Data="@Helpers"
                                TextProperty="FullName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="Helper" Text="Helper is required" />

        <RadzenFormField Text="Origin Location" Style="width:100%">
            <ChildContent>
                <RadzenDropDown Name="OriginLocation"
                                @bind-Value="Model.OriginLocation"
                                Data="@OriginLocations"
                                TextProperty="LocationName"
                                Style="width:100%" />
            </ChildContent>
        </RadzenFormField>
        <RadzenRequiredValidator Component="OriginLocation" Text="Origin Location is required" />

        <RadzenFormField Text="Truck Seal" Style="width:100%">
            <ChildContent>
                <RadzenTextBox Name="TruckSeal"
                               @bind-Value="Model.TruckSeal"
                               Style="width:100%" />
            </ChildContent>
        </RadzenFormField>

        <RadzenRequiredValidator Component="TruckSeal" Text="Truck Seal is required" />

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="8px">
            <RadzenButton Text="Cancel" Click="OnCancel" ButtonStyle="ButtonStyle.Warning" />
            <RadzenButton Text="Confirm" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" />
        </RadzenStack>

    </RadzenStack>

</RadzenTemplateForm>