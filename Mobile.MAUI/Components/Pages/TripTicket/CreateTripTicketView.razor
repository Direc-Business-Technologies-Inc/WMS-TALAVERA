@page "/tripticket/create"
@using Mobile.MAUI.Components.Base
@using Shared.Libraries.ViewModel
@using Shared.Libraries.ViewModel.ItemFulfillment
@using Shared.Libraries.ViewModel.TripTicket

@layout CleanLayout
@inherits BaseComponent

<RadzenStack Gap="12px" Style="">
    <PageHeading Title="Packed ItemFulfillments" BackPath="/" Click="LoadData"/>
    <RadzenStack id="recent-scanned" class="box-toolbar-page">

    </RadzenStack>

    <Loading IsLoading="@ActionGetItemFulfillments.Busy" Text="Loading ItemFulfillments..">
        <ChildContent>
            <RadzenStack>
                <RadzenTabs @bind-SelectedIndex="ActiveTabIndex">
                    <Tabs>
                        <RadzenTabsItem Text="UnScanned">
                            <EmptyListTemplate ReloadCallback="LoadData" Visible="@(Data.Count == 0)" />
                            <RadzenDataList Data="@(Data?.Where(x => !x.isScanned).ToList() ?? Enumerable.Empty<ItemFulfillmentVM>())"
                                            TItem="ItemFulfillmentVM"
                                            class="trans-list">
                                <Template Context="row">
                                    <RadzenStack class="trans-card"
                                                 Orientation="Orientation.Horizontal"
                                                 AlignItems="AlignItems.Center"
                                                 JustifyContent="JustifyContent.SpaceBetween">

                                        <RadzenStack Gap="4px">
                                            <RadzenText Text="@row.OrderNumber"
                                                        class="trans-number" />

                                            <RadzenText class="trans-detail"
                                                        Text="@($"Document Date: {row.NetsuiteOrderCreatedDate:MMMM d, yyyy}")" />
                                        </RadzenStack>

                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="6px" class="trans-badges">
                                            <RadzenBadge Text="@row.GetShortName(row.OrderStatus)" class="trans-status-badge" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </Template>
                            </RadzenDataList>
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="Scanned">
                            <EmptyListTemplate ReloadCallback="LoadData" Visible="@(Data.Count == 0)" />
                            <RadzenDataList Data="@(ScannedItemFulfillments ?? Enumerable.Empty<ItemFulfillmentVM>())"
                                            TItem="ItemFulfillmentVM"
                                            class="trans-list">
                                <Template Context="row">
                                    <RadzenStack class="trans-card"
                                                 Orientation="Orientation.Horizontal"
                                                 AlignItems="AlignItems.Center"
                                                 JustifyContent="JustifyContent.SpaceBetween">

                                        <RadzenStack Gap="4px">
                                            <RadzenText Text="@row.OrderNumber"
                                                        class="trans-number" />

                                            <RadzenText class="trans-detail"
                                                        Text="@($"Document Date: {row.NetsuiteOrderCreatedDate:MMMM d, yyyy}")" />
                                        </RadzenStack>

                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="6px" class="trans-badges">
                                            <RadzenBadge Text="@row.GetShortName(row.OrderStatus)" class="trans-status-badge" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </Template>
                            </RadzenDataList>
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
                <RadzenCard Style="position:fixed; bottom:50px; right:10px; z-index:1000;" class="rz-p-2 rz-border-radius-6 rz-w-fit-content">
                    <RadzenStack Gap="16px" Orientation="Orientation.Horizontal">
                        <RadzenButton class="rz-border-radius-5" Click="@(async () => await SaveScan())" Disabled="@(ActionSaveScan.Busy)"
                                      ButtonStyle="ButtonStyle.Success" Icon="@(ActionSaveScan.Busy ? "schedule" : "save")" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
        </ChildContent>
    </Loading>

    @* <SavingLoading IsVisible="ActionSaveScan.Busy" Text="Saving scanned items..." /> *@
</RadzenStack>