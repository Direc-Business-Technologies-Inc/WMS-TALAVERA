@using Mobile.MAUI.Components.Base
@using Shared.Libraries.ViewModel.TransferOrder
@inherits BaseComponent
<RadzenStack class="mt-4 rz-px-2">
    <RadzenText Text="Scan or enter a transaction number to find it" />
    <RadzenRow class="rz-w-100"><RadzenColumn Size="11"><RadzenTextBox Value="@SearchText" Placeholder="Transfer order number" Style="width:100%" @oninput="OnSearchInput" @onkeydown="HandleEnter" /></RadzenColumn><RadzenColumn Size="1"><RadzenButton Icon="refresh" Click="LoadData" Disabled="@IsListLoading" /></RadzenColumn></RadzenRow>
    @if (Data.Count > 0) { <RadzenButton Text="Clear Search" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="ClearSearch" /> }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage)) { <RadzenText Text="@ErrorMessage" class="rz-color-danger" /> }
    <RadzenDataList Data="@FilteredData" TItem="TransferOrderVM" class="trans-list"><Template Context="row"><RadzenStack class="trans-card" @onclick="@(() => NavManager.NavigateTo($"/receiving/transferorder/itemfulfillment/{row.NetsuiteOrderInternalId}/{row.OrderNumber}"))" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"><RadzenStack Gap="4px"><RadzenText Text="@row.OrderNumber" class="trans-number" /><RadzenText class="trans-detail" Text="@($"Document Date: {(row.NetsuiteOrderCreatedDate == DateTime.MinValue ? "N/A" : row.NetsuiteOrderCreatedDate.ToString("MMMM d, yyyy"))}")" /></RadzenStack><RadzenBadge Text="@row.GetShortName(row.OrderStatus)" class="trans-status-badge" /></RadzenStack></Template></RadzenDataList>
    @if (HasMore) { <RadzenButton Text="@(IsLoadingMore ? "Loading..." : "Load more")" Icon="expand_more" Disabled="@IsLoadingMore" Click="LoadMore" /> }
</RadzenStack>
