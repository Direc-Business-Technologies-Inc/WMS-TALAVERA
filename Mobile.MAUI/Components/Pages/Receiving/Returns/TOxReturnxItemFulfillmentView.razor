@page "/receiving/returns/itemfulfillment/{NetsuiteOrderInternalId:int}/{TOOrderNumber}"
@using Mobile.MAUI.Components.Base
@using Shared.Libraries.ViewModel
@using Shared.Libraries.ViewModel.ItemFulfillment

@layout CleanLayout
@inherits BaseComponent
<RadzenStack>
    <PageHeading Title="Item Fulfillments" BackPath="/receiving" Click="LoadItemFulfillments" Id="@TOOrderNumber" />

    <RadzenStack class="mt-4">
        <RadzenStack Gap="8px" class="rz-px-2 rz-mb-2">
            <RadzenTextBox Value="@SearchText"
                           Placeholder="Search.."
                           Style="width:100%;"
                           @oninput="@OnSearchInput" />

            @if (!string.IsNullOrWhiteSpace(SearchText))
            {
                <RadzenButton Text="Clear Search"
                              Icon="close"
                              ButtonStyle="ButtonStyle.Base"
                              Size="ButtonSize.Small"
                              Click="@ClearSearch" />
            }
        </RadzenStack>

        <Loading IsLoading="@ActionGetTOxItemfulfillments.Busy" Text="Loading ItemFulfillments..">
            <ChildContent>
                <RadzenStack>
                    <EmptyListTemplate ReloadCallback="LoadData" Visible="@(FilteredData.Count == 0)" />
                    <RadzenDataList Data="@(FilteredData ?? Enumerable.Empty<ItemFulfillmentVM>())"
                                    TItem="ItemFulfillmentVM"
                                    class="trans-list">
                        <Template Context="row">
                            <RadzenStack class="trans-card"
                                         @onclick="@(() => NavManager.NavigateTo($"/receiving/returns/itemfulfillment/items/{NetsuiteOrderInternalId}/{TOOrderNumber}/{row.OrderNumber}"))"
                                         Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         JustifyContent="JustifyContent.SpaceBetween">

                                <RadzenStack Gap="4px">
                                    <RadzenText Text="@row.OrderNumber"
                                                class="trans-number" />

                                    @* <RadzenText class="trans-detail"
                                                Text="@($"Vendor: {row.CustomerName}")" /> *@

                                    <RadzenText class="trans-detail"
                                                Text="@($"Document Date: {row.NetsuiteOrderCreatedDate:MMMM d, yyyy}")" />
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal" Gap="6px" class="trans-badges">
                                    <RadzenBadge Text="@row.GetShortName(row.OrderStatus)" class="trans-status-badge" />
                                </RadzenStack>
                            </RadzenStack>
                        </Template>
                    </RadzenDataList>
                </RadzenStack>
            </ChildContent>
        </Loading>
    </RadzenStack>
</RadzenStack>


