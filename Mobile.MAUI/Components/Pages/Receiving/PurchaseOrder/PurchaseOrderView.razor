@using Mobile.MAUI.Components.Base
@using Shared.Libraries.ViewModel.PurchaseOrder

@inherits BaseComponent
<RadzenStack>
    <RadzenStack class="mt-4">
        <RadzenStack Gap="8px" class="rz-px-2 rz-mb-2">
                    <RadzenText Text="Scan or enter a transaction number to find it" />
                    <RadzenRow class="rz-w-100">
                        <RadzenColumn Size="11"><RadzenTextBox Value="@SearchText" Placeholder="Purchase order number" Style="width:100%" @oninput="@OnSearchInput" @onkeydown="@HandleEnter" /></RadzenColumn>
                        <RadzenColumn Size="1"><RadzenButton Icon="refresh" Click="LoadData" Disabled="@IsListLoading" /></RadzenColumn>
                    </RadzenRow>
                    @if (Data.Count > 0) { <RadzenButton Text="Clear Search" Icon="close" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="ClearSearch" /> }
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <RadzenText Text="@ErrorMessage" class="rz-color-danger" />
                    }
                    <RadzenStack>
                        <RadzenDataList Data="@FilteredData" TItem="PurchaseOrderVM" class="trans-list">
                            <Template Context="row">
                                <RadzenStack class="trans-card" @onclick="@(() => NavManager.NavigateTo($"/receiving/purchaseorder/{row.OrderNumber}"))" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenStack Gap="4px"><RadzenText Text="@row.OrderNumber" class="trans-number" /><RadzenText class="trans-detail" Text="@($"Vendor: {row.CustomerName}")" /><RadzenText class="trans-detail" Text="@($"Document Date: {(row.NetsuiteOrderDocumentDate == DateTime.MinValue ? "N/A" : row.NetsuiteOrderDocumentDate.ToString("MMMM d, yyyy"))}")" /></RadzenStack>
                                    <RadzenBadge Text="@row.GetShortName(row.OrderStatus)" class="trans-status-badge" />
                                </RadzenStack>
                            </Template>
                        </RadzenDataList>
                    </RadzenStack>
        </RadzenStack>
    </RadzenStack>
</RadzenStack>


