@using Mobile.MAUI.Components.Base

@inherits BaseComponent
<RadzenStack>
    <RadzenStack class="mt-4">
        <Loading IsLoading="@IsLoading" Text="Looking up purchase order..">
            <ChildContent>
                <RadzenStack Gap="8px" class="rz-px-2 rz-mb-2">
                    <RadzenTextBox Value="@SearchText"
                                   Placeholder="Scan or enter purchase order number"
                                   Style="width:100%"
                                   @oninput="@OnSearchInput"
                                   @onkeydown="@HandleEnter" />
                    <RadzenButton Text="Find" Icon="search" Click="SubmitLookup" Disabled="@IsLoading" />
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <RadzenText Text="@ErrorMessage" class="rz-color-danger" />
                    }
                </RadzenStack>
            </ChildContent>
        </Loading>
    </RadzenStack>
</RadzenStack>


