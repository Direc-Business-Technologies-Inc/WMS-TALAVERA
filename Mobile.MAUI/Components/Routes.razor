@using Microsoft.AspNetCore.Components.Authorization
@using Mobile.MAUI.Components.Layout.MainLayout
<CascadingAuthenticationState>
	<Router  AppAssembly="@typeof(MauiProgram).Assembly">
		<Found Context="routeData">

			<AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">

			</AuthorizeRouteView>

			<FocusOnNavigate RouteData="@routeData" Selector="h1" />
		</Found>


	</Router>
</CascadingAuthenticationState>

@code {
	[Inject] NavigationManager _navManager { get; set; }
	[Inject] AuthenticationStateProvider _authStateProvider { get; set; }
	[Inject] ThemeService _themeService { get; set; }

	bool IsLoading { get; set; }

	protected override async Task OnInitializedAsync()
	{
		IsLoading = false;

		_themeService.SetTheme(new ThemeOptions { Theme = "standard" });
	}
}