@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<RadzenComponents />
<AuthorizeView>
    <Authorized>
        <RadzenStack Gap="0">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-p-2 rz-w-100 rz-shadow-4 position-sticky top-0 rz-background-color-white" Style="z-index: 1000 !important;">
                <RadzenImage Style="height: 35px;" Path="/img/talavera.svg" />

                @if (AuthState is not null)
                {
                    <ProfileButton />
                }
            </RadzenStack>

            <RadzenStack class="rz-w-100 rz-pb-6">
                @if (AuthState is not null)
                {
                    @Body
                }

            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Gap="5vw" class="position-fixed bottom-0 rz-w-100 rz-p-1 rz-background-color-white" Style="z-index: 1000 !important;">
                <RadzenImage Path="/img/wms_logo_small.png" />
                <RadzenText TextStyle="TextStyle.Caption" class="rz-p-0 rz-m-0">
                    <text>
                        <span>Powered by</span>
                        <span class="fw-bold">Direc Business Technologies Inc.</span>
                        <span>@("@")</span>
                        <span class="fw-bold">2026</span>
                    </text>
                </RadzenText>
            </RadzenStack>
        </RadzenStack>
    </Authorized>
    <Authorizing>
        <LoadingSpinner />
    </Authorizing>
    <NotAuthorized>
        <UnAuthorizedView />
    </NotAuthorized>
</AuthorizeView>