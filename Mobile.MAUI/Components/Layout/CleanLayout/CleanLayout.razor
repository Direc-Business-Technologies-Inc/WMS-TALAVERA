@using Mobile.MAUI.Services
@using Mobile.MAUI.ViewModel
@using Mobile.MAUI.Helpers
@using System.Text.Json

@inherits LayoutComponentBase

<RadzenComponents />
<div style="min-width: 100vw !important; min-height: 100vh !important">
    @Body
</div>

@code {
    [Inject] ApiClientService Client { get; set; }
    protected override async Task OnInitializedAsync()
    {
        string? settings = await SecureStorage.GetAsync("endpoint-settings");
        ClientEndpointVM endpoint;
        if (string.IsNullOrWhiteSpace(settings))
        {
            endpoint = EndpointDefaults.Polaris;
            await SecureStorage.SetAsync("endpoint-settings", JsonSerializer.Serialize(endpoint));
        }
        else
        {
            endpoint = JsonSerializer.Deserialize<ClientEndpointVM>(settings) ?? EndpointDefaults.Polaris;
        }

        Client.UpdateClient(endpoint);
    }
}
