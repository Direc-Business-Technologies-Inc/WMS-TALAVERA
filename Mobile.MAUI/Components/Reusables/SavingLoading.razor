<style>
    .save-loading-overlay {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(0, 0, 0, 0.36);
        z-index: 9999;
    }

    .save-loading-box {
        background: var(--rz-background-color-base, #ffffff);
        padding: 12px 16px;
        border-radius: 8px;
        display: flex;
        gap: 12px;
        align-items: center;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        min-width: 220px;
        justify-content: center;
    }
</style>

@if (IsVisible)
{
    <div class="save-loading-overlay" role="status" aria-live="polite">
        <div class="save-loading-box">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Light"
                                       Size="ProgressBarCircularSize.Medium"
                                       Value="100"
                                       ShowValue="false"
                                       Mode="ProgressBarMode.Indeterminate"
                                       AriaLabel="Saving" />
            <RadzenText Text="@Text" class="my-text-subtitle1" />
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Text { get; set; } = "Saving...";
}